---
import { brand, brandLocation, languages, messages, type Lang } from '../data/site';
import '../styles/site.css';
import '../styles/theme.css';
import HeaderPreferences from '../components/HeaderPreferences.astro';
import ColorSchemeInit from '../components/ColorSchemeInit.astro';
interface Props { lang:Lang; title:string; description:string; }
const {lang,title,description}=Astro.props;
const t=messages[lang];
const suffix=Astro.url.pathname.replace(/^\/(?:fr|ar|en)/,'') || '/';
const translate=(next:Lang)=>`/${next}${suffix}`.replace(/\/+/g,'/');
const publicOrigin=Astro.site?.origin ?? 'https://nextgen-buildingsolutions.com';
const canonical=publicOrigin+Astro.url.pathname;
const whats=`https://wa.me/${brand.whatsapp}`;
const navSections = ['gammes','catalogue','distributeurs','ressources','a-propos','contact'] as const;
---
<!doctype html>
<html lang={lang} dir={lang==='ar'?'rtl':'ltr'}>
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  <link rel="canonical" href={canonical} />
  {languages.map(l=><link rel="alternate" hreflang={l} href={publicOrigin+translate(l)} />)}
  <link rel="alternate" hreflang="x-default" href={publicOrigin+translate('fr')} />
  <ColorSchemeInit />
  <title>{title} · NextGen Building Solutions</title>
 </head>
 <body>
  <a class="skip" href="#main">{lang==='ar'?'انتقل إلى المحتوى':'Aller au contenu / Skip to content'}</a>
  <header class="header">
   <div class="container header-row">
    <a href={`/${lang}/`} class="brand" aria-label={t.homeLabel} aria-current={Astro.url.pathname===`/${lang}/`?'page':undefined}>
      <img src="/images/Logo1.jpg" alt="" width="148" height="82" />
    </a>
    <nav aria-label={t.navigationLabel} class="nav">
      {navSections.map(s=><a href={`/${lang}/${s}/`} aria-current={Astro.url.pathname===`/${lang}/${s}/`?'page':undefined}>{t.menu[s]}</a>)}
    </nav>
    <HeaderPreferences lang={lang} suffix={suffix} languageLabel={t.languageLabel} />
    <!-- Native disclosure: keyboard and touch accessible, no JS or tracking. -->
    <details class="mobile-nav">
      <summary class="mobile-trigger" aria-label={t.mobileMenu}><span aria-hidden="true">☰</span><span class="mobile-trigger-label">{t.mobileMenu}</span></summary>
      <nav class="mobile-links" aria-label={t.navigationLabel}>
        {navSections.map(s=><a href={`/${lang}/${s}/`} aria-current={Astro.url.pathname===`/${lang}/${s}/`?'page':undefined}>{t.menu[s]}</a>)}
      </nav>
    </details>
   </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="footer"><div class="container footer-grid">
    <div><h2>NextGen Building Solutions</h2><p>{brandLocation[lang]}</p><a href={`tel:${brand.phone.replaceAll(' ','')}`}>{brand.phone}</a><p><a href={`mailto:${brand.email}`}>{brand.email}</a></p></div>
    <div><strong>{t.menu.ressources}</strong><p><a href={`/${lang}/ressources/`}>{t.menu.ressources}</a></p><p><a href={`/${lang}/mentions-legales/`}>{t.menu['mentions-legales']}</a></p><p><a href={`/${lang}/confidentialite/`}>{t.menu.confidentialite}</a></p></div>
    <div><strong><bdi dir="ltr">FENEK</bdi></strong><p>{t.noPrices}</p><a class="btn btn-outline" href={whats} rel="noopener noreferrer" target="_blank">WhatsApp</a></div>
   </div><div class="container footnote">© {new Date().getFullYear()} NextGen Building Solutions · {t.mark}</div></footer>
 </body>
</html>
