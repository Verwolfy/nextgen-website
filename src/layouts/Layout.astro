---
import { brand, brandLocation, languages, messages, type Lang } from '../data/site';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/site.css';
import '../styles/theme.css';
import '../styles/v3.css';
import HeaderPreferences from '../components/HeaderPreferences.astro';
import SiteSearch from '../components/SiteSearch.astro';
import AnimatedHeaderLogo from '../components/AnimatedHeaderLogo.astro';
import ThemeInit from '../components/ThemeInit.astro';
interface Props { lang:Lang; title:string; description:string; }
const {lang,title,description}=Astro.props;
const t=messages[lang];
const suffix=Astro.url.pathname.replace(/^\/(?:fr|ar|en)/,'') || '/';
const translate=(next:Lang)=>`/${next}${suffix}`.replace(/\/+/g,'/');
const publicOrigin=Astro.site?.origin ?? 'https://nextgen-buildingsolutions.com';
const canonical=publicOrigin+Astro.url.pathname;
const whats=`https://wa.me/${brand.whatsapp}`;
const navSections = ['a-propos','gammes','catalogue','distributeurs','ressources','contact'] as const;
// The tiny Nexo/Geno poster is the first-frame visual only on localized homepages.
const preloadWelcomePoster=/^\/(?:fr|ar|en)\/$/.test(Astro.url.pathname);
const homePosterV4 = existsSync(join(process.cwd(), 'public/videos/nextgen-nexo-geno-welcome-v4.mp4')) && existsSync(join(process.cwd(), 'public/videos/nextgen-nexo-geno-poster-v4.webp'));
const welcomePosterUrl = homePosterV4 ? '/videos/nextgen-nexo-geno-poster-v4.webp?v=20261107-v4' : '/videos/nextgen-nexo-geno-poster.webp?v=20261105-v3';
// Search is built only from generated public HTML, never from private Supabase drafts.
const searchKind = /^\/(?:fr|ar|en)\/catalogue\/[^/]+\/$/.test(Astro.url.pathname) ? 'product'
  : /^\/(?:fr|ar|en)\/documentation\/[^/]+\/$/.test(Astro.url.pathname) ? 'sheet'
  : /^\/(?:fr|ar|en)\/gammes\/[^/]+\/$/.test(Astro.url.pathname) ? 'application' : 'page';
const skipLabel:Record<Lang,string>={fr:'Aller au contenu principal',ar:'الانتقال إلى المحتوى الرئيسي',en:'Skip to main content'};
---
<!doctype html>
<html lang={lang} dir={lang==='ar'?'rtl':'ltr'}>
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <ThemeInit />
  <meta name="theme-color" content="#0c2439" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f8fafb" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
  {preloadWelcomePoster && <link rel="preload" as="image" href={welcomePosterUrl} fetchpriority="high" />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  <link rel="canonical" href={canonical} />
  {languages.map(l=><link rel="alternate" hreflang={l} href={publicOrigin+translate(l)} />)}
  <link rel="alternate" hreflang="x-default" href={publicOrigin+translate('fr')} />
  <title>{title} · NextGen Building Solutions</title>
 </head>
 <body>
  <a class="skip" href="#main">{skipLabel[lang]}</a>
  <header class="header">
   <div class="container header-row">
    <div class="brand-search">
      <AnimatedHeaderLogo lang={lang} homeLabel={t.homeLabel} isHome={Astro.url.pathname===`/${lang}/`} />
      <SiteSearch lang={lang} />
    </div>
    <nav aria-label={t.navigationLabel} class="nav">
      {navSections.map(s=><a href={`/${lang}/${s}/`} aria-current={Astro.url.pathname===`/${lang}/${s}/`?'page':undefined}>{t.menu[s]}</a>)}
    </nav>
    <HeaderPreferences lang={lang} suffix={suffix} languageLabel={t.languageLabel} />
    <!-- Native disclosure: keyboard and touch accessible, no JS or tracking. -->
    <details class="mobile-nav">
      <summary class="mobile-trigger" aria-label={t.mobileMenu}><span aria-hidden="true">☰</span><span class="mobile-trigger-label">{t.mobileMenu}</span></summary>
      <nav class="mobile-links" aria-label={t.navigationLabel}>
        {navSections.map(s=><a href={`/${lang}/${s}/`} aria-current={Astro.url.pathname===`/${lang}/${s}/`?'page':undefined}>{t.menu[s]}</a>)}
      </nav>
    </details>
   </div>
  </header>
  <main id="main" data-pagefind-body data-pagefind-filter={`kind:${searchKind}`} data-pagefind-meta={`kind:${searchKind}`}><slot /></main>
  <footer class="footer"><div class="container footer-grid">
    <div><h2>NextGen Building Solutions</h2><p>{brandLocation[lang]}</p><a href={`tel:${brand.phone.replaceAll(' ','')}`}>{brand.phone}</a><p><a href={`mailto:${brand.email}`}>{brand.email}</a></p></div>
    <div><strong>{t.menu.ressources}</strong><p><a href={`/${lang}/ressources/`}>{t.menu.ressources}</a></p><p><a href={`/${lang}/mentions-legales/`}>{t.menu['mentions-legales']}</a></p><p><a href={`/${lang}/confidentialite/`}>{t.menu.confidentialite}</a></p></div>
    <div><strong><bdi dir="ltr">FENEK</bdi></strong><p>{t.noPrices}</p><a class="btn btn-outline" href={whats} rel="noopener noreferrer" target="_blank">WhatsApp</a></div>
   </div><div class="container footnote">© {new Date().getFullYear()} NextGen Building Solutions · {t.mark}</div></footer>
 </body>
</html>
<style>
  /* Preserve logo/navigation balance with a text-bearing search capsule. */
  :global(.header .container.header-row){
    max-width:1440px;padding-inline:clamp(14px,2.2vw,30px);gap:clamp(10px,1.1vw,18px)
  }
  :global(.header .header-row .nav){gap:clamp(8px,1vw,14px)}
  .brand-search{display:flex;align-items:center;gap:9px;flex-shrink:0;min-width:0}
  @media(max-width:580px){
    .brand-search{gap:4px}
    :global(.header-row){gap:4px}
    :global(.header-preferences .theme-icon){display:none}
  }
  @media(max-width:360px){
    .brand-search{gap:3px}
    :global(.header-row){gap:4px}
    :global(.header-preferences .theme-icon){display:none}
  }
</style>
