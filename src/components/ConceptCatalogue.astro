---
import {ranges,rangeName,rangeColor,type Lang} from '../data/site';
import {catalogueProjects,projectsByRange,conceptPackshot} from '../lib/catalogue-projets';
import {catalogueCopy} from '../data/catalogue-content';
interface Props { lang:Lang }
const {lang}=Astro.props;
const t=catalogueCopy[lang];
---
<section class="catalogue-projects" aria-labelledby="catalogue-count">
  <div class="concepts-lead">
    <div><span class="eyebrow">{t.concept}</span><h2 id="catalogue-count">{t.title}</h2><p>{t.intro}</p></div>
    <span class="concept-count">{catalogueProjects.length} <small>{t.count}</small></span>
  </div>
  <p class="editorial-caution" role="note">{t.review}</p>
  <nav class="concept-range-nav" aria-label={t.rangeNav}>
    {ranges.map(g=><a href={'#catalogue-'+g} style={'--range-color:'+rangeColor[g]}><span class="concept-dot" aria-hidden="true"></span><bdi dir="ltr">{rangeName[g]}</bdi><small>{projectsByRange(g).length}</small></a>)}
  </nav>
  {ranges.map(g=><section id={'catalogue-'+g} class="concept-range-section" aria-labelledby={'range-title-'+g} style={'--range-color:'+rangeColor[g]}>
    <div class="concept-range-title"><div><span class="concept-range-color" aria-hidden="true"></span><h2 id={'range-title-'+g}><bdi dir="ltr">{rangeName[g]}</bdi></h2></div><span>{projectsByRange(g).length} {t.count}</span></div>
    <div class="concept-products-grid">
      {projectsByRange(g).map(p=><a class="concept-product-card" href={'/'+lang+'/catalogue/'+p.slug+'/'} aria-label={p.nom+' — '+t.view}>
        <div class="concept-product-image concept-packshot-container"><img src={conceptPackshot(p,"card")} alt="" width="680" height="680" loading="lazy" /></div>
        <div class="concept-product-copy"><span class="concept-product-status">{t.status}</span><h3><bdi dir="ltr">{p.nom}</bdi></h3><p>{p.contenu[lang].accroche}</p>
          <div class="concept-formats">{p.conditionnements.length?p.conditionnements.slice(0,3).map(x=><span>{x.format}</span>):<span>{t.unknownFormat}</span>}</div>
          <strong class="concept-view">{t.view}<span aria-hidden="true"> ↗</span></strong>
        </div>
      </a>)}
    </div>
  </section>)}
</section>
