---
/**
 * A4 print-only presentation for provisional FENEK catalogue references.
 * NOT an issued technical data sheet or safety data sheet.
 * The real FT/FDS specimens remain private until laboratory and HSE approval.
 */
import {brand, rangeName, type Lang} from '../data/site';
import {conceptPackshot, type CatalogueProject} from '../lib/catalogue-projets';
import {guideFor} from '../data/fenek-guides';

interface Props { lang:Lang; product:CatalogueProject; }
const {lang,product} = Astro.props;
const detail = product.contenu[lang];
const guide = guideFor(product.code, product.gamme, lang);
const text = {
  fr: {
    company:'NEXT GENERATION BUILDING SOLUTIONS',
    title:'FICHE PRODUIT',
    state:'PRÉSENTATION PROVISOIRE — DONNÉES TECHNIQUES NON VALIDÉES',
    reference:'Référence',range:'Gamme',formats:'Conditionnements indicatifs',document:'Statut du document',
    provisional:'Présentation de catalogue',unavailable:'Sur demande',
    use:'Utilisation',points:'Aperçu / Points clés',safety:'Environnement et sécurité',
    technical:'Informations techniques',conditions:'Conditions d’application',quantity:'Consommation et dosage',
    steps:'Étapes d’application',before:'Étude et préparation',method:'Choix du procédé',
    after:'Contrôles après application',source:'Origine des informations',
    sourceNote:'Description éditoriale de la gamme ; aucune performance mesurée n’est certifiée par ce document.',
    packNote:'Visuel et formats indicatifs. Vérifier les conditionnements et la documentation propre à chaque produit.',
    footer:'Présentation de gamme uniquement. FT détaillée et FDS spécifiques non émises sur ce site : demander les documents validés.',
  },
  ar: {
    company:'NEXT GENERATION BUILDING SOLUTIONS',
    title:'بطاقة المنتج',
    state:'عرض أولي — البيانات الفنية غير معتمدة',
    reference:'المرجع',range:'المجموعة',formats:'العبوات المقترحة',document:'حالة الوثيقة',
    provisional:'عرض من الكتالوج',unavailable:'عند الطلب',
    use:'الاستخدام',points:'نظرة عامة / نقاط أساسية',safety:'البيئة والسلامة',
    technical:'المعلومات الفنية',conditions:'شروط التطبيق',quantity:'الاستهلاك والجرعة',
    steps:'مراحل التطبيق',before:'الدراسة والتحضير',method:'اختيار الطريقة',
    after:'التحقق بعد التطبيق',source:'مصدر المعلومات',
    sourceNote:'وصف تعريفي للمجموعة؛ لا يؤكد هذا المستند أي أداء مقاس للمنتج.',
    packNote:'الصور والعبوات إرشادية؛ ينبغي تأكيد عبوة المنتج ووثائقه الخاصة.',
    footer:'هذا مستند تعريفي فقط. النشرة الفنية التفصيلية وصحيفة بيانات السلامة غير صادرتين هنا؛ اطلب الوثائق المعتمدة.',
  },
  en: {
    company:'NEXT GENERATION BUILDING SOLUTIONS',
    title:'PRODUCT SHEET',
    state:'PROVISIONAL PRESENTATION — TECHNICAL DATA NOT APPROVED',
    reference:'Reference',range:'Range',formats:'Indicative packaging',document:'Document status',
    provisional:'Catalogue presentation',unavailable:'On request',
    use:'Application',points:'Overview / Key considerations',safety:'Environment and safety',
    technical:'Technical information',conditions:'Application conditions',quantity:'Consumption and dosage',
    steps:'Application stages',before:'Review and preparation',method:'Process selection',
    after:'Post-application checks',source:'Information source',
    sourceNote:'Editorial range description only; this document does not certify measured product performance.',
    packNote:'Visual and formats are indicative; confirm actual packaging and product-specific documentation.',
    footer:'Range overview only. Product-specific technical and safety data sheets are not issued here; request approved documents.',
  },
}[lang];
const formats = product.conditionnements.map(c=>c.format).join(' · ') || text.unavailable;
---
<section class="fenek-print-document" lang={lang} dir={lang==='ar'?'rtl':'ltr'}>
  <div class="fenek-print-masthead">
    <img class="fenek-print-logo" src="/images/Logo1.jpg" width="170" height="118"
         alt="NEXTGEN Building Solutions" />
    <div class="fenek-print-name">{text.company}</div>
    <div class="fenek-print-slants" aria-hidden="true"></div>
  </div>
  <div class="fenek-print-line" aria-hidden="true"></div>
  <div class="fenek-print-banner"><span>{text.title}</span></div>
  <div class="fenek-print-product-name"><bdi dir="ltr">{product.nom}</bdi></div>
  <p class="fenek-print-subtitle">{detail.accroche}</p>
  <div class="fenek-print-status" role="note">{text.state}</div>

  <div class="fenek-print-intro">
    <dl class="fenek-print-metadata">
      <div><dt>{text.reference}</dt><dd><bdi dir="ltr">{product.nom}</bdi></dd></div>
      <div><dt>{text.range}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
      <div><dt>{text.formats}</dt><dd>{formats}</dd></div>
      <div><dt>{text.document}</dt><dd>{text.provisional}</dd></div>
    </dl>
    <figure class="fenek-print-packshot">
      <img src={conceptPackshot(product,'full')} width="800" height="800"
           alt={product.nom + ' — ' + text.packNote} />
      <figcaption>{text.packNote}</figcaption>
    </figure>
  </div>

  <div class="fenek-print-cards">
    <section class="fenek-print-card">
      <h2>{text.use}</h2>
      <p>{detail.usages.join(' · ')}</p>
    </section>
    <section class="fenek-print-card">
      <h2>{text.points}</h2>
      <p>{guide.focus}</p>
    </section>
    <section class="fenek-print-card">
      <h2>{text.safety}</h2>
      <p>{guide.safety}</p>
    </section>
    <section class="fenek-print-card">
      <h2>{text.technical}</h2>
      <p>{guide.checks}</p>
    </section>
    <section class="fenek-print-card">
      <h2>{text.conditions}</h2>
      <p>{guide.before}</p>
    </section>
    <section class="fenek-print-card">
      <h2>{text.quantity}</h2>
      <p>{guide.quantity}</p>
    </section>
  </div>

  <section class="fenek-print-process">
    <h2>{text.steps}</h2>
    <ol>
      <li><strong><span>01</span> {text.before}</strong><p>{guide.before}</p></li>
      <li><strong><span>02</span> {text.method}</strong><p>{guide.method}</p></li>
      <li><strong><span>03</span> {text.after}</strong><p>{guide.after}</p></li>
    </ol>
  </section>
  <div class="fenek-print-source"><strong>{text.source} :</strong> {text.sourceNote}</div>
  <div class="fenek-print-footer">
    <div><strong>NEXTGEN BUILDING SOLUTIONS</strong></div>
    <div><a href={'mailto:'+brand.email}>{brand.email}</a></div>
    <p>{text.footer}</p>
  </div>
</section>
