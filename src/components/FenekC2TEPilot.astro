---
import {existsSync} from 'node:fs';
import {join} from 'node:path';
import {brand,rangeName,type Lang} from '../data/site';
import {catalogueProjects,conceptPackshot,packagingLabelFor,type CatalogueProject} from '../lib/catalogue-projets';
import {productWhatsappHref} from '../data/contact-channels';
import {c2teCopy,c2teRequirements,c2teFamilyReferences} from '../data/fenek-c2te-reference';
import FenekApplicationGuide from './FenekApplicationGuide.astro';
import FenekPrintTechnicalCover from './FenekPrintTechnicalCover.astro';
import FenekPrintApplicationPage from './FenekPrintApplicationPage.astro';

interface Props {lang:Lang;product:CatalogueProject;}
const {lang,product}=Astro.props;
if(product.code!=='BOND-C2TE')throw Error('C2TE pilot cannot render other FENEK references');
const t=c2teCopy[lang];
const image=conceptPackshot(product,'full');
const pdfHref=`/docs/fiches/fenek-bond-c2te-${lang}.pdf`;
const hasPublishedPdf=existsSync(join(process.cwd(),'public',pdfHref.slice(1)));
const emailHref='mailto:'+brand.email+'?subject='+encodeURIComponent(t.requestLabel+' — '+product.nom);
const related=['BOND-C2FT','BOND-C2TE','BOND-C2TE-S1'].map(code=>{
  const item=catalogueProjects.find(p=>p.code===code);
  if(!item)throw Error('Missing related BOND adhesive '+code);
  return item;
});
const schema={
  '@context':'https://schema.org','@type':'Product',
  name:product.nom,description:t.lead,identifier:product.code,
  brand:{'@type':'Brand',name:'FENEK'},image:new URL(image,Astro.site??Astro.url).href,
  url:Astro.url.href,
};
const comparisonMeaning:Record<string,Record<Lang,string>>={
  'BOND-C2FT':{fr:'C2 : adhérence améliorée ; F : prise rapide ; T : glissement réduit',ar:'C2: التصاق محسن، F: تصلب سريع، T: انزلاق منخفض',en:'C2 improved adhesion; F fast setting; T reduced slip'},
  'BOND-C2TE':{fr:'C2 : adhérence améliorée ; T : glissement réduit ; E : temps ouvert prolongé',ar:'C2: التصاق محسن، T: انزلاق منخفض، E: زمن مفتوح ممتد',en:'C2 improved adhesion; T reduced slip; E extended open time'},
  'BOND-C2TE-S1':{fr:'C2TE avec S1 : classe de déformabilité additionnelle',ar:'C2TE مع S1: فئة إضافية لقابلية التشوه',en:'C2TE with S1: additional deformability class'},
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)}/>
<div class="page-head fenek-sheet-head" style="--range-color:#12295C">
  <div class="container">
    <a class="concept-back" href={`/${lang}/catalogue/`}>{lang==='ar'?'العودة إلى الكتالوج':lang==='en'?'Back to catalogue':'Retour au catalogue'}</a>
    <span class="eyebrow">FENEK · BOND · C2TE</span>
    <h1><bdi dir="ltr">{product.nom}</bdi></h1><p>{t.lead}</p>
  </div>
</div>
<article class="fenek-product-page fenek-c2te-pilot" data-c2te-pilot data-reference={product.code}>
  <div class="container">
    <header class="fenek-product-intro">
      <div class="fenek-product-intro-copy">
        <span class="fenek-sheet-overline">{t.sheetTitle}</span>
        <h2>{t.lead}</h2>
        <ul class="fenek-product-quick-points">{t.benefits.map(item=><li>{item}</li>)}</ul>
      </div>
      <figure class="fenek-product-image"><img src={image} width="800" height="800" loading="eager" decoding="async" alt={`${product.nom} — ${t.sheetTitle}`} /></figure>
    </header>
    <nav class="fenek-section-nav" aria-label={lang==='ar'?'أقسام بطاقة المنتج':lang==='en'?'Product sheet sections':'Rubriques de la fiche'}>
      {['fenek-overview','fenek-details','fenek-application','fenek-documents'].map((anchor,i)=><a href={'#'+anchor}>{t.nav[i]}</a>)}
    </nav>
    <section id="fenek-overview" class="fenek-document-section" aria-labelledby="fenek-overview-heading">
      <h2 id="fenek-overview-heading">{t.nav[0]}</h2>
      <div class="fenek-overview-grid">
        <div><h3>{t.usesTitle}</h3><ul>{t.uses.map(line=><li>{line}</li>)}</ul></div>
        <div><h3>{t.substratesTitle}</h3><ul>{t.substrates.map(line=><li>{line}</li>)}</ul></div>
        <div><h3>{t.identityTitle}</h3><dl class="fenek-document-data">
          <div><dt>{t.referenceLabel}</dt><dd><bdi dir="ltr">{product.code}</bdi></dd></div>
          <div><dt>{t.formatLabel}</dt><dd>{product.conditionnements.map(x=>packagingLabelFor(x.format,lang)).join(' · ')}</dd></div>
        </dl></div>
      </div>
    </section>
    <section id="fenek-details" class="fenek-document-section" aria-labelledby="fenek-details-heading">
      <h2 id="fenek-details-heading">{t.nav[1]}</h2>
      <dl class="fenek-document-data c2te-identity">
        <div><dt>{t.designationLabel}</dt><dd><bdi dir="ltr">{product.nom}</bdi></dd></div>
        <div><dt>{t.rangeLabel}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
        <div><dt>{t.classLabel}</dt><dd><bdi dir="ltr">C2TE — EN 12004-1:2017</bdi></dd></div>
      </dl>
      <h3>{t.techTitle}</h3>
      <div class="c2te-table-wrap"><table class="c2te-table">
        <thead><tr><th scope="col">{t.fieldTitle}</th><th scope="col">{t.metricTitle}</th></tr></thead>
        <tbody>{c2teRequirements.map(row=><tr data-c2te-source-type={row.kind}><th scope="row">{row.label[lang]}</th><td dir="ltr">{row.value}</td></tr>)}</tbody>
      </table></div>
      <h3>{t.familyTitle}</h3>
      <div class="c2te-table-wrap"><table class="c2te-table">
        <thead><tr><th scope="col">{t.fieldTitle}</th><th scope="col">{t.metricTitle}</th></tr></thead>
        <tbody>{c2teFamilyReferences.map(row=><tr data-c2te-source-type={row.kind}><th scope="row">{row.label[lang]}</th><td dir="ltr">{row.value}</td></tr>)}</tbody>
      </table></div>
    </section>
    <section id="fenek-application" class="fenek-document-section" aria-labelledby="fenek-application-heading">
      <h2 id="fenek-application-heading">{t.applicationTitle}</h2>
      <div class="c2te-two-column">
        <div><h3>{t.prepTitle}</h3><ul>{t.preparation.map(line=><li>{line}</li>)}</ul></div>
        <div><h3>{t.conditionsTitle}</h3><ul>{t.conditions.map(line=><li>{line}</li>)}</ul></div>
      </div>
      <h3>{t.consumptionTitle}</h3>
      <div class="c2te-table-wrap"><table class="c2te-table"><tbody>
        {c2teFamilyReferences.filter(x=>x.key.startsWith('consommation-')||x.key==='eau').map(x=><tr><th scope="row">{x.label[lang]}</th><td dir="ltr">{x.value}</td></tr>)}
      </tbody></table></div>
      <h3>{t.stepsTitle}</h3>
      <FenekApplicationGuide lang={lang} product={product} concise/>
      <h3>{t.safetyTitle}</h3>
      <ul>{t.safety.map(line=><li>{line}</li>)}</ul>
    </section>
    <section id="fenek-documents" class="fenek-document-section" aria-labelledby="fenek-documents-heading">
      <h2 id="fenek-documents-heading">{t.documentsTitle}</h2>
      <div class="actions">
        {hasPublishedPdf ? <a class="btn" href={pdfHref} download>{t.downloadLabel}</a> : <button type="button" class="btn" data-print-market-sheet>{t.printLabel}</button>}
        <a class="btn btn-muted" href={emailHref}>{t.requestLabel}</a>
        <a class="btn btn-muted" href={`/${lang}/contact/`}>{t.quoteLabel}</a>
        <a class="btn btn-muted" href={productWhatsappHref(lang,product,'documentation')} target="_blank" rel="noopener noreferrer">{t.whatsappLabel}</a>
      </div>
    </section>
    <section class="fenek-document-section" aria-labelledby="c2te-related-heading">
      <h2 id="c2te-related-heading">{t.comparisonTitle}</h2>
      <p>{t.comparisonNote}</p>
      <div class="c2te-table-wrap"><table class="c2te-table">
        <thead><tr><th scope="col">{t.designationLabel}</th><th scope="col">{t.classLabel}</th></tr></thead>
        <tbody>{related.map(item=><tr><th scope="row"><a href={`/${lang}/documentation/${item.slug}/`}><bdi dir="ltr">{item.nom}</bdi></a></th><td>{comparisonMeaning[item.code][lang]}</td></tr>)}</tbody>
      </table></div>
      <h3>{t.relatedTitle}</h3>
      <div class="actions">{related.filter(item=>item.code!==product.code).map(item=><a class="btn btn-muted" href={`/${lang}/documentation/${item.slug}/`}><bdi dir="ltr">{item.nom}</bdi></a>)}</div>
    </section>
  </div>
</article>

<FenekPrintTechnicalCover lang={lang} product={product} metrics={c2teRequirements}
  standard={'EN 12004-1:2017'} printClass="fenek-c2te-print"
  lead={t.lead} uses={t.uses} preparation={t.preparation} safety={t.safety} />
<FenekPrintApplicationPage lang={lang} product={product} />
<style>
  .fenek-c2te-pilot .fenek-document-section h3{font-size:clamp(1.1rem,2vw,1.35rem);margin:20px 0 12px}
  .fenek-c2te-pilot .fenek-document-section ul{padding-inline-start:1.4rem}
  .fenek-c2te-pilot .fenek-document-section li{margin-block:5px}
  .c2te-identity{max-width:780px}
  .c2te-table-wrap{max-width:100%;overflow-x:auto}
  .c2te-table{width:100%;border-collapse:collapse;font-size:.94rem;margin:12px 0 22px}
  .c2te-table th,.c2te-table td{padding:11px 15px;text-align:start;border-bottom:1px solid #dce7e7;vertical-align:top}
  .c2te-table thead{background:#103651;color:#fff}
  .c2te-table tbody tr:nth-child(even){background:#f2f7f5}
  .c2te-table td[dir="ltr"]{white-space:nowrap;font-variant-numeric:tabular-nums}
  .c2te-table a{text-decoration:underline;text-decoration-color:#078d62;text-underline-offset:4px}
  .c2te-two-column{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .c2te-reference-note{font-size:.88rem;line-height:1.62;color:#45616f}
  :global(html[data-theme='dark']) .fenek-c2te-pilot .c2te-table tbody tr:nth-child(even){background:#19384a}
  :global(html[data-theme='dark']) .fenek-c2te-pilot .c2te-table tbody th,
  :global(html[data-theme='dark']) .fenek-c2te-pilot .c2te-table tbody td{color:#edf7fa;border-color:#4a6677}
  :global(html[data-theme='dark']) .fenek-c2te-pilot .c2te-table thead{background:#1d4b58;color:#fff}
  :global(html[data-theme='dark']) .fenek-c2te-pilot .c2te-reference-note{color:#c5dce8}
  .fenek-c2te-pilot a:focus-visible,.fenek-c2te-pilot button:focus-visible{outline:3px solid #00895e;outline-offset:4px}
  @media(max-width:760px){.c2te-two-column{grid-template-columns:1fr}.c2te-table{font-size:.86rem}.c2te-table th,.c2te-table td{padding:9px}}
  @media print{
    .fenek-c2te-print .fenek-print-card{break-inside:avoid;padding:3mm 4mm;margin-bottom:2.4mm}
    .fenek-c2te-print .fenek-print-card h2{font-size:10pt}
    .fenek-c2te-print .c2te-print-table{width:100%;border-collapse:collapse;font-size:8.3pt}
    .fenek-c2te-print .c2te-print-table td,.fenek-c2te-print .c2te-print-table th{border-bottom:1px solid #d9e4e7;padding:1.6mm 2mm;text-align:start}
    .fenek-c2te-print .c2te-print-table td[dir="ltr"]{white-space:nowrap}
    .fenek-c2te-print .fenek-print-card ul{margin:1mm 0;padding-inline-start:6mm;font-size:8.1pt}
    .fenek-c2te-print .fenek-print-footer{font-size:7.9pt}
  }
</style>
