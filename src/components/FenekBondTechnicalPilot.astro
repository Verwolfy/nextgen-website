---
import {existsSync} from 'node:fs';
import {join} from 'node:path';
import {brand,rangeName,type Lang} from '../data/site';
import {catalogueProjects,conceptPackshot,packagingLabelFor,type CatalogueProject} from '../lib/catalogue-projets';
import {productWhatsappHref} from '../data/contact-channels';
import {bondRemainingRecords} from '../data/fenek-bond-remaining-reference';
import FenekApplicationGuide from './FenekApplicationGuide.astro';

interface Props {lang:Lang;product:CatalogueProject;}
const {lang,product}=Astro.props;
const reference=bondRemainingRecords[product.code];
if(!reference)throw Error('Missing BOND technical reference '+product.code);
const t=reference.copy[lang];
const image=conceptPackshot(product,'full');
const pdfHref=`/docs/fiches/${product.slug}-${lang}.pdf`;
const hasPublishedPdf=existsSync(join(process.cwd(),'public',pdfHref.slice(1)));
const emailHref='mailto:'+brand.email+'?subject='+encodeURIComponent(t.requestLabel+' — '+product.nom);
const groups:Record<string,string[]>={
 grout:['BOND-CG1','BOND-CG2WA'],
 screed:['BOND-CT-C25-F5'],
 render:['BOND-GP-CSII','BOND-OC-CSIII'],
 bedding:['BOND-GR-HR','BOND-R3','BOND-R4'],
 masonry:['BOND-M5','BOND-M10'],
 repair:['BOND-R2','BOND-R3','BOND-R4'],
};
const related=(groups[reference.group]??[product.code]).map(code=>{
 const item=catalogueProjects.find(p=>p.code===code);
 if(!item)throw Error('Missing BOND related reference '+code);
 return item;
});
const schema={
  '@context':'https://schema.org','@type':'Product',
  name:product.nom,description:t.lead,identifier:product.code,
  brand:{'@type':'Brand',name:'FENEK'},image:new URL(image,Astro.site??Astro.url).href,
  url:Astro.url.href,
};
const comparisonMeaning=Object.fromEntries(related.map(item=>[
 item.code,{fr:item.contenu.fr.accroche,ar:item.contenu.ar.accroche,en:item.contenu.en.accroche}
])) as Record<string,Record<Lang,string>>;
---
<script type="application/ld+json" set:html={JSON.stringify(schema)}/>
<div class="page-head fenek-sheet-head" style="--range-color:#12295C">
  <div class="container">
    <a class="concept-back" href={`/${lang}/catalogue/`}>{lang==='ar'?'العودة إلى الكتالوج':lang==='en'?'Back to catalogue':'Retour au catalogue'}</a>
    <span class="eyebrow">FENEK · BOND · {reference.short}</span>
    <h1><bdi dir="ltr">{product.nom}</bdi></h1><p>{t.lead}</p>
  </div>
</div>
<article class="fenek-product-page fenek-bond-technical-pilot" data-bond-technical-pilot data-reference={product.code}>
  <div class="container">
    <header class="fenek-product-intro">
      <div class="fenek-product-intro-copy">
        <span class="fenek-sheet-overline">{t.sheetTitle}</span>
        <h2>{t.lead}</h2>
        <ul class="fenek-product-quick-points">{t.benefits.map(item=><li>{item}</li>)}</ul>
      </div>
      <figure class="fenek-product-image"><img src={image} width="800" height="800" loading="eager" decoding="async" alt={`${product.nom} — ${t.sheetTitle}`} /></figure>
    </header>
    <nav class="fenek-section-nav" aria-label={lang==='ar'?'أقسام بطاقة المنتج':lang==='en'?'Product sheet sections':'Rubriques de la fiche'}>
      {['fenek-overview','fenek-details','fenek-application','fenek-documents'].map((anchor,i)=><a href={'#'+anchor}>{t.nav[i]}</a>)}
    </nav>
    <section id="fenek-overview" class="fenek-document-section" aria-labelledby="fenek-overview-heading">
      <h2 id="fenek-overview-heading">{t.nav[0]}</h2>
      <div class="fenek-overview-grid">
        <div><h3>{t.usesTitle}</h3><ul>{t.uses.map(line=><li>{line}</li>)}</ul></div>
        <div><h3>{t.substratesTitle}</h3><ul>{t.substrates.map(line=><li>{line}</li>)}</ul></div>
        <div><h3>{t.identityTitle}</h3><dl class="fenek-document-data">
          <div><dt>{t.referenceLabel}</dt><dd><bdi dir="ltr">{product.code}</bdi></dd></div>
          <div><dt>{t.formatLabel}</dt><dd>{product.conditionnements.map(x=>packagingLabelFor(x.format,lang)).join(' · ')}</dd></div>
        </dl></div>
      </div>
    </section>
    <section id="fenek-details" class="fenek-document-section" aria-labelledby="fenek-details-heading">
      <h2 id="fenek-details-heading">{t.nav[1]}</h2>
      <dl class="fenek-document-data bond-technical-identity">
        <div><dt>{t.designationLabel}</dt><dd><bdi dir="ltr">{product.nom}</bdi></dd></div>
        <div><dt>{t.rangeLabel}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
        <div><dt>{t.classLabel}</dt><dd><bdi dir="ltr">{reference.short} — {reference.standard}</bdi></dd></div>
      </dl>
      <h3>{t.techTitle}</h3>
      <div class="bond-technical-table-wrap"><table class="bond-technical-table">
        <thead><tr><th scope="col">{t.fieldTitle}</th><th scope="col">{t.metricTitle}</th></tr></thead>
        <tbody>{reference.requirements.map(row=><tr data-bond-source-type={row.kind}><th scope="row">{row.label[lang]}</th><td dir="ltr">{row.value}</td></tr>)}</tbody>
      </table></div>
      <h3>{t.familyTitle}</h3>
      <div class="bond-technical-table-wrap"><table class="bond-technical-table">
        <thead><tr><th scope="col">{t.fieldTitle}</th><th scope="col">{t.metricTitle}</th></tr></thead>
        <tbody>{reference.family.map(row=><tr data-bond-source-type={row.kind}><th scope="row">{row.label[lang]}</th><td dir="ltr">{row.value}</td></tr>)}</tbody>
      </table></div>
    </section>
    <section id="fenek-application" class="fenek-document-section" aria-labelledby="fenek-application-heading">
      <h2 id="fenek-application-heading">{t.applicationTitle}</h2>
      <div class="bond-technical-two-column">
        <div><h3>{t.prepTitle}</h3><ul>{t.preparation.map(line=><li>{line}</li>)}</ul></div>
        <div><h3>{t.conditionsTitle}</h3><ul>{t.conditions.map(line=><li>{line}</li>)}</ul></div>
      </div>
      <h3>{t.consumptionTitle}</h3>
      <div class="bond-technical-table-wrap"><table class="bond-technical-table"><tbody>
        {reference.family.filter(x=>reference.family.slice(0,2).some(row=>row.key===x.key)).map(x=><tr><th scope="row">{x.label[lang]}</th><td dir="ltr">{x.value}</td></tr>)}
      </tbody></table></div>
      <h3>{t.stepsTitle}</h3>
      <FenekApplicationGuide lang={lang} product={product} concise/>
      <h3>{t.safetyTitle}</h3>
      <ul>{t.safety.map(line=><li>{line}</li>)}</ul>
    </section>
    <section id="fenek-documents" class="fenek-document-section" aria-labelledby="fenek-documents-heading">
      <h2 id="fenek-documents-heading">{t.documentsTitle}</h2>
      <div class="actions">
        {hasPublishedPdf ? <a class="btn" href={pdfHref} download>{t.downloadLabel}</a> : <button type="button" class="btn" data-print-market-sheet>{t.printLabel}</button>}
        <a class="btn btn-muted" href={emailHref}>{t.requestLabel}</a>
        <a class="btn btn-muted" href={`/${lang}/contact/`}>{t.quoteLabel}</a>
        <a class="btn btn-muted" href={productWhatsappHref(lang,product,'documentation')} target="_blank" rel="noopener noreferrer">{t.whatsappLabel}</a>
      </div>
    </section>
    <section class="fenek-document-section" aria-labelledby="bond-technical-related-heading">
      <h2 id="bond-technical-related-heading">{t.comparisonTitle}</h2>
      <p>{t.comparisonNote}</p>
      <div class="bond-technical-table-wrap"><table class="bond-technical-table">
        <thead><tr><th scope="col">{t.designationLabel}</th><th scope="col">{t.classLabel}</th></tr></thead>
        <tbody>{related.map(item=><tr><th scope="row"><a href={`/${lang}/documentation/${item.slug}/`}><bdi dir="ltr">{item.nom}</bdi></a></th><td>{comparisonMeaning[item.code][lang]}</td></tr>)}</tbody>
      </table></div>
      <h3>{t.relatedTitle}</h3>
      <div class="actions">{related.filter(item=>item.code!==product.code).map(item=><a class="btn btn-muted" href={`/${lang}/documentation/${item.slug}/`}><bdi dir="ltr">{item.nom}</bdi></a>)}</div>
    </section>
  </div>
</article>
<section class="fenek-print-document fenek-bond-technical-print" lang={lang} dir={lang==='ar'?'rtl':'ltr'}>
  <div class="fenek-print-masthead">
    <img class="fenek-print-logo" src="/images/Logo1.jpg" width="170" height="118" alt="NextGen Building Solutions"/>
    <div class="fenek-print-name">NEXTGEN BUILDING SOLUTIONS</div><div class="fenek-print-slants" aria-hidden="true"></div>
  </div>
  <div class="fenek-print-line" aria-hidden="true"></div>
  <div class="fenek-print-banner"><span>{t.sheetTitle}</span></div>
  <div class="fenek-print-product-name"><bdi dir="ltr">{product.nom}</bdi></div>
  <p class="fenek-print-subtitle">{t.lead}</p>
  <div class="fenek-print-intro">
    <dl class="fenek-print-metadata">
      <div><dt>{t.referenceLabel}</dt><dd><bdi dir="ltr">{product.code}</bdi></dd></div>
      <div><dt>{t.rangeLabel}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
      <div><dt>{t.classLabel}</dt><dd><bdi dir="ltr">{reference.short} — {reference.standard}</bdi></dd></div>
      <div><dt>{t.formatLabel}</dt><dd>{product.conditionnements.map(x=>packagingLabelFor(x.format,lang)).join(' · ')}</dd></div>
    </dl>
    <figure class="fenek-print-packshot"><img src={image} width="800" height="800" alt={t.sheetTitle}/></figure>
  </div>
  <section class="fenek-print-card"><h2>{t.techTitle}</h2>
    <table class="bond-technical-print-table">{reference.requirements.map(row=><tr><th scope="row">{row.label[lang]}</th><td dir="ltr">{row.value}</td></tr>)}</table>
  </section>
  <section class="fenek-print-card"><h2>{t.familyTitle}</h2>
    <table class="bond-technical-print-table">{reference.family.map(row=><tr><th scope="row">{row.label[lang]}</th><td dir="ltr">{row.value}</td></tr>)}</table>
  </section>
  <section class="fenek-print-card"><h2>{t.prepTitle}</h2><ul>{t.preparation.map(line=><li>{line}</li>)}</ul></section>
  <section class="fenek-print-card"><h2>{t.safetyTitle}</h2><ul>{t.safety.map(line=><li>{line}</li>)}</ul></section>
  <div class="fenek-print-footer"><strong>NEXTGEN BUILDING SOLUTIONS</strong><p>{brand.email}</p></div>
</section>
<style>
  .fenek-bond-technical-pilot .fenek-document-section h3{font-size:clamp(1.1rem,2vw,1.35rem);margin:20px 0 12px}
  .fenek-bond-technical-pilot .fenek-document-section ul{padding-inline-start:1.4rem}
  .fenek-bond-technical-pilot .fenek-document-section li{margin-block:5px}
  .bond-technical-identity{max-width:780px}
  .bond-technical-table-wrap{max-width:100%;overflow-x:auto}
  .bond-technical-table{width:100%;border-collapse:collapse;font-size:.94rem;margin:12px 0 22px}
  .bond-technical-table th,.bond-technical-table td{padding:11px 15px;text-align:start;border-bottom:1px solid #dce7e7;vertical-align:top}
  .bond-technical-table thead{background:#103651;color:#fff}
  .bond-technical-table tbody tr:nth-child(even){background:#f2f7f5}
  .bond-technical-table td[dir="ltr"]{white-space:nowrap;font-variant-numeric:tabular-nums}
  .bond-technical-table a{text-decoration:underline;text-decoration-color:#078d62;text-underline-offset:4px}
  .bond-technical-two-column{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .bond-technical-reference-note{font-size:.88rem;line-height:1.62;color:#45616f}
  :global(html[data-theme='dark']) .fenek-bond-technical-pilot .bond-technical-table tbody tr:nth-child(even){background:#19384a}
  :global(html[data-theme='dark']) .fenek-bond-technical-pilot .bond-technical-table tbody th,
  :global(html[data-theme='dark']) .fenek-bond-technical-pilot .bond-technical-table tbody td{color:#edf7fa;border-color:#4a6677}
  :global(html[data-theme='dark']) .fenek-bond-technical-pilot .bond-technical-table thead{background:#1d4b58;color:#fff}
  :global(html[data-theme='dark']) .fenek-bond-technical-pilot .bond-technical-reference-note{color:#c5dce8}
  .fenek-bond-technical-pilot a:focus-visible,.fenek-bond-technical-pilot button:focus-visible{outline:3px solid #00895e;outline-offset:4px}
  @media(max-width:760px){.bond-technical-two-column{grid-template-columns:1fr}.bond-technical-table{font-size:.86rem}.bond-technical-table th,.bond-technical-table td{padding:9px}}
  @media print{
    .fenek-bond-technical-print .fenek-print-card{break-inside:avoid;padding:3mm 4mm;margin-bottom:2.4mm}
    .fenek-bond-technical-print .fenek-print-card h2{font-size:10pt}
    .fenek-bond-technical-print .bond-technical-print-table{width:100%;border-collapse:collapse;font-size:8.3pt}
    .fenek-bond-technical-print .bond-technical-print-table td,.fenek-bond-technical-print .bond-technical-print-table th{border-bottom:1px solid #d9e4e7;padding:1.6mm 2mm;text-align:start}
    .fenek-bond-technical-print .bond-technical-print-table td[dir="ltr"]{white-space:nowrap}
    .fenek-bond-technical-print .fenek-print-card ul{margin:1mm 0;padding-inline-start:6mm;font-size:8.1pt}
    .fenek-bond-technical-print .fenek-print-footer{font-size:7.9pt}
  }
</style>
