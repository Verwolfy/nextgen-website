---
import {languages, type Lang} from '../data/site';
interface Props { lang:Lang; suffix:string; languageLabel:string; }
const {lang,suffix,languageLabel}=Astro.props;
const urlFor=(next:Lang)=>`/${next}${suffix}`.replace(/\/+/g,'/');
const copy={
  fr:{lang:'Langue',dark:'Activer le mode nuit',light:'Activer le mode jour'},
  ar:{lang:'اللغة',dark:'تفعيل الوضع الليلي',light:'تفعيل الوضع النهاري'},
  en:{lang:'Language',dark:'Switch to dark mode',light:'Switch to light mode'},
}[lang];
const short={fr:'Fr',ar:'ع',en:'En'};
const long={fr:'Français',ar:'العربية',en:'English'};
---
<div class="header-preferences" data-header-preferences>
  <button type="button" class="theme-switch" data-theme-switch role="switch"
    aria-checked="false" aria-label={copy.dark}
    data-label-dark={copy.dark} data-label-light={copy.light}>
    <span class="theme-switch-track" aria-hidden="true"><span class="theme-switch-knob"></span></span>
  </button>
  <span class="theme-icon" aria-hidden="true">
    <svg class="theme-icon-sun" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
    <svg class="theme-icon-moon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 13A8.8 8.8 0 0 1 11 3.2 8.9 8.9 0 1 0 20.8 13Z"/></svg>
  </span>
  <details class="language-picker" data-language-picker>
    <summary aria-label={languageLabel}>
      <span class="language-picker-title">{copy.lang}</span>
      <span class="language-picker-current" lang={lang} dir={lang==='ar'?'rtl':'ltr'}>{short[lang]}</span>
      <svg class="language-picker-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2 4 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <nav class="language-picker-menu" aria-label={languageLabel}>
      {languages.map(l=><a href={urlFor(l)} lang={l} dir={l==='ar'?'rtl':'ltr'}
        aria-current={l===lang?'page':undefined}>{long[l]}</a>)}
    </nav>
  </details>
</div>
<script>
  const themeButton=document.querySelector<HTMLButtonElement>('[data-theme-switch]');
  const picker=document.querySelector<HTMLDetailsElement>('[data-language-picker]');
  type Mode='light'|'dark';
  const prefKey='nextgen-ui-theme';
  const system=window.matchMedia('(prefers-color-scheme: dark)');
  const stored=():Mode|null=>{
    try {const v=window.localStorage.getItem(prefKey);return v==='light'||v==='dark'?v:null;}
    catch {return null;}
  };
  const apply=(mode:Mode)=>{
    document.documentElement.dataset.theme=mode;
    if(themeButton){
      const dark=mode==='dark';
      themeButton.setAttribute('aria-checked',String(dark));
      themeButton.setAttribute('aria-label',dark?themeButton.dataset.labelLight!:themeButton.dataset.labelDark!);
      themeButton.title=dark?themeButton.dataset.labelLight!:themeButton.dataset.labelDark!;
    }
  };
  apply(document.documentElement.dataset.theme==='dark'?'dark':'light');
  themeButton?.addEventListener('click',()=>{
    const next:Mode=document.documentElement.dataset.theme==='dark'?'light':'dark';
    try {window.localStorage.setItem(prefKey,next);}catch {/* Private browsing: keep in-page preference. */}
    apply(next);
  });
  system.addEventListener('change',event=>{if(!stored())apply(event.matches?'dark':'light');});
  window.addEventListener('storage',event=>{
    if(event.key===prefKey)apply(stored()??(system.matches?'dark':'light'));
  });
  if(picker){
    document.addEventListener('pointerdown',event=>{
      if(picker.open&&!picker.contains(event.target as Node))picker.open=false;
    });
    picker.addEventListener('keydown',event=>{
      if(event.key==='Escape'){picker.open=false;picker.querySelector('summary')?.focus();}
    });
  }
</script>
<style>
  .header-preferences{display:flex;align-items:center;gap:6px;flex:0 0 auto;direction:ltr;margin-inline-start:auto}
  .theme-switch{flex:0 0 44px;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;cursor:pointer;border-radius:30px}
  .theme-switch-track{display:block;position:relative;width:40px;height:21px;background:#d0d6dd;border-radius:99px;transition:background .2s}
  .theme-switch-knob{position:absolute;top:-1px;left:-1px;width:23px;height:23px;border:1px solid #e0e7ee;background:#fff;border-radius:50%;box-shadow:0 2px 4px #0c213624;transition:transform .2s}
  .theme-icon{display:inline-flex;align-items:center;justify-content:center;width:27px;min-width:27px;color:#52647a}
  .theme-icon-moon{display:none}
  .language-picker{position:relative;min-width:86px;z-index:41}
  .language-picker summary{position:relative;display:grid;grid-template-columns:1fr 15px;column-gap:5px;align-items:center;min-height:48px;padding:5px 9px 5px 12px;list-style:none;border:1px solid #d7dfe7;border-radius:9px;background:#f6f8fb;color:#536579;cursor:pointer}
  .language-picker summary::-webkit-details-marker{display:none}
  .language-picker summary::marker{content:''}
  .language-picker-title{font-size:.69rem;line-height:1.13;grid-column:1/-1;color:#64748b;white-space:nowrap}
  .language-picker-current{font-size:.95rem;line-height:1.4;align-self:center;color:#34465e}
  .language-picker-chevron{color:#526477;transition:transform .2s}
  .language-picker[open] .language-picker-chevron{transform:rotate(180deg)}
  .language-picker-menu{position:absolute;inset-inline-end:0;top:calc(100% + 7px);width:max(145px,100%);padding:5px;border:1px solid #d3dee6;border-radius:10px;background:#fff;box-shadow:0 15px 34px #0b223528;z-index:42}
  .language-picker-menu a{display:block;padding:9px 11px;min-height:39px;border-radius:6px;color:#28435a;white-space:nowrap;font-size:.88rem;text-decoration:none}
  .language-picker-menu a:hover,.language-picker-menu a:focus-visible{background:#e9f4ef;color:#036a48}
  .language-picker-menu a[aria-current=page]{background:#e4f2ec;color:#006b47;font-weight:800}
  .theme-switch:focus-visible,.language-picker summary:focus-visible,.language-picker-menu a:focus-visible{outline:3px solid #129766;outline-offset:3px}
  :global(html[data-theme='dark']) .theme-switch-track{background:#087d5a}
  :global(html[data-theme='dark']) .theme-switch-knob{transform:translateX(19px);background:#eaf8f2;border-color:#b7e8d5}
  :global(html[data-theme='dark']) .theme-icon{color:#86b5dc}
  :global(html[data-theme='dark']) .theme-icon-sun{display:none}
  :global(html[data-theme='dark']) .theme-icon-moon{display:block}
  :global(html[data-theme='dark']) .language-picker summary{background:#142a3f;border-color:#466074;color:#ecf4fa}
  :global(html[data-theme='dark']) .language-picker-current{color:#e8f5fc}
  :global(html[data-theme='dark']) .language-picker-title{color:#b3c8d7}
  :global(html[data-theme='dark']) .language-picker-chevron{color:#c0d9e7}
  :global(html[data-theme='dark']) .language-picker-menu{background:#142b43;border-color:#466074;box-shadow:0 17px 35px #0008}
  :global(html[data-theme='dark']) .language-picker-menu a{color:#e9f5fc}
  :global(html[data-theme='dark']) .language-picker-menu a:hover,
  :global(html[data-theme='dark']) .language-picker-menu a:focus-visible{background:#25475a;color:#9cebc6}
  :global(html[data-theme='dark']) .language-picker-menu a[aria-current=page]{background:#14493c;color:#adf5d2}
  @media(max-width:580px){.header-preferences{gap:3px}.theme-switch{width:39px;flex-basis:39px}.theme-icon{width:23px;min-width:23px}.theme-icon svg{width:21px;height:21px}.language-picker{min-width:75px}.language-picker summary{padding-inline:8px;min-height:43px}}
  @media(max-width:360px){.header-preferences{gap:1px}.theme-switch{width:35px;flex-basis:35px}.theme-switch-track{transform:scale(.86)}.theme-icon{width:18px;min-width:18px}.theme-icon svg{width:18px;height:18px}.language-picker{min-width:67px}.language-picker summary{padding:4px 6px;min-height:42px}.language-picker-title{font-size:.63rem}}
  @media(prefers-reduced-motion:reduce){.theme-switch-track,.theme-switch-knob,.language-picker-chevron{transition:none}}
  @media print{.header-preferences{display:none!important}}
</style>
