---
import { languages, type Lang } from '../data/site';
interface Props { lang: Lang; suffix: string; languageLabel: string; }
const { lang, suffix, languageLabel } = Astro.props;
const translate=(next: Lang)=>`/${next}${suffix}`;
const labels = {
  fr: { mode: 'Activer le mode nuit', day: 'Activer le mode jour', night: 'Activer le mode nuit', language: 'Langue' },
  ar: { mode: 'تفعيل الوضع الليلي', day: 'تفعيل الوضع النهاري', night: 'تفعيل الوضع الليلي', language: 'اللغة' },
  en: { mode: 'Switch to dark mode', day: 'Switch to light mode', night: 'Switch to dark mode', language: 'Language' },
}[lang];
const langNames: Record<Lang,string> = { fr:'Français', ar:'العربية', en:'English' };
---
<div class="header-preferences">
  <div class="theme-choice">
    <button
      class="theme-switch" type="button" role="switch" aria-checked="false"
      aria-label={labels.mode}
      data-theme-toggle data-label-day={labels.day} data-label-night={labels.night}>
      <span class="theme-switch-knob" aria-hidden="true"></span>
    </button>
    <span class="theme-choice-icon theme-icon-day" aria-hidden="true">☀</span>
    <span class="theme-choice-icon theme-icon-night" aria-hidden="true">☾</span>
  </div>
  <details class="language-choice" data-language-choice>
    <summary aria-label={languageLabel} aria-haspopup="true">
      <span class="language-choice-caption">{labels.language}</span>
      <span class="language-choice-selected" lang={lang} dir="auto">{lang === 'fr' ? 'Fr' : lang === 'ar' ? 'Ar' : 'En'}</span>
      <span class="language-choice-chevron" aria-hidden="true"></span>
    </summary>
    <nav class="language-choice-options" aria-label={languageLabel}>
      {languages.map(l=><a href={translate(l)} lang={l} dir="auto"
        aria-current={l===lang?'page':undefined}>{langNames[l]} <span aria-hidden="true">{l.toUpperCase()}</span></a>)}
    </nav>
  </details>
</div>
<script>
  const root=document.documentElement;
  const toggle=document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const query=window.matchMedia('(prefers-color-scheme: dark)');
  const themeKey='nextgen-color-theme';
  const getSaved=():string|null=>{
    try {const v=window.localStorage.getItem(themeKey);return v==='dark'||v==='light'?v:null;}catch{return null;}
  };
  const setTheme=(theme:'light'|'dark')=>{
    root.dataset.theme=theme;
    root.style.colorScheme=theme;
    if(toggle){
      const active=theme==='dark';
      toggle.setAttribute('aria-checked',String(active));
      toggle.setAttribute('aria-label', active?toggle.dataset.labelDay!:toggle.dataset.labelNight!);
    }
  };
  setTheme(root.dataset.theme==='dark'?'dark':'light');
  toggle?.addEventListener('click',()=>{
    const next=root.dataset.theme==='dark'?'light':'dark';
    try{window.localStorage.setItem(themeKey,next);}catch{/* State still changes for this page. */}
    setTheme(next);
  });
  query.addEventListener('change',event=>{
    if(!getSaved())setTheme(event.matches?'dark':'light');
  });
  const picker=document.querySelector<HTMLDetailsElement>('[data-language-choice]');
  document.addEventListener('pointerdown',event=>{
    if(picker?.open && !picker.contains(event.target as Node))picker.open=false;
  });
  picker?.addEventListener('keydown',event=>{
    if(event.key==='Escape'){picker.open=false;picker.querySelector('summary')?.focus();}
  });
</script>
