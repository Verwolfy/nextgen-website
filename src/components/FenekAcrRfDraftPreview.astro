---
/**
 * Lot 189: inline comparison-quality preview for ACR-RF.
 * This is not the published product manual, not FT/FDS approval, and has no
 * runtime toggle that could silently replace the six reviewed V3 drawings.
 */
import type { Lang } from '../data/site';
interface Props { lang: Lang; steps: { title: string }[]; }
const {lang,steps}=Astro.props;
const sprite='/images/application-premium/fenek-proof-acr-rf-steps-v4.webp';
const copy={
  fr:{
    heading:'Nouvelle qualité graphique — aperçu V4',
    badge:'Brouillon graphique',
    note:'Ces six scènes sont une proposition visuelle non validée techniquement. Les gestes, les équipements et les marquages doivent être contrôlés avec la FT/FDS approuvée avant toute utilisation comme mode d’emploi.',
    original:'Illustrations actuellement publiées (conservées)',
    compare:'Comparer les 12 illustrations sur la page de revue',
    scene:'Scène',
  },
  en:{
    heading:'New illustration quality — V4 preview',
    badge:'Visual draft — not approved',
    note:'These six scenes are an unapproved design proposal, not validated application instructions. Verify procedures, protective equipment and generated markings against approved technical and safety sheets.',
    original:'Currently published illustrations (preserved)',
    compare:'Compare all 12 illustrations on the review page (French)',
    scene:'Scene',
  },
  ar:{
    heading:'معاينة جودة الرسومات الجديدة — V4',
    badge:'مسودة بصرية غير معتمدة',
    note:'هذه المشاهد الستة مقترح بصري غير معتمد وليست تعليمات تطبيق معتمدة. يجب التحقق من خطوات العمل ومعدات الوقاية والعلامات الظاهرة وفق النشرات الفنية ونشرات السلامة المعتمدة.',
    original:'الرسومات المنشورة حالياً (محفوظة)',
    compare:'مقارنة الرسومات الاثني عشر في صفحة المراجعة (بالفرنسية)',
    scene:'المشهد',
  }
}[lang];
---
<section class="fenek-acrrf-v4" data-acrrf-v4-preview data-approval="BROUILLON" aria-label={copy.heading}>
  <div class="fenek-acrrf-v4-head">
    <h4>{copy.heading}</h4>
    <span class="fenek-acrrf-v4-badge">{copy.badge}</span>
  </div>
  <p class="fenek-acrrf-v4-note" role="note">{copy.note}</p>
  <ol class="fenek-acrrf-v4-grid">
    {steps.map((step,i)=><li class="fenek-acrrf-v4-item" data-acrrf-v4-step={i+1}>
      <div class="fenek-acrrf-v4-photo"
        style={`--sprite-position:${(i%3)*50}% ${Math.floor(i/3)*100}%;background-image:url('${sprite}')`}
        role="img" aria-label={`${copy.scene} ${i+1}: ${step.title}`}></div>
      <h5><span aria-hidden="true">{i+1}.</span> {step.title}</h5>
    </li>)}
  </ol>
  <a class="fenek-acrrf-v4-compare" href="/fr/avant-premiere/fenek-proof-acr-rf/">{copy.compare}</a>
  <h4 class="fenek-acrrf-v4-original">{copy.original}</h4>
</section>
<style>
  .fenek-acrrf-v4{margin:0 0 19px;min-width:0;border:1px solid #bfdcd0;border-radius:13px;padding:clamp(10px,2vw,17px);background:#f5fbf8;color:#153b52}
  .fenek-acrrf-v4-head{display:flex;align-items:center;justify-content:space-between;gap:9px;flex-wrap:wrap}
  .fenek-acrrf-v4-head h4{font-size:clamp(1rem,1.7vw,1.23rem);line-height:1.35;margin:0;color:#103756}
  .fenek-acrrf-v4-badge{background:#e6f3eb;border:1px solid #a1d3b9;border-radius:25px;color:#0f684c;padding:5px 9px;font-size:.72rem;font-weight:800}
  .fenek-acrrf-v4-note{font-size:.84rem;line-height:1.6;margin:10px 0 16px;max-width:85ch;color:#3d5e66}
  .fenek-acrrf-v4-grid{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin:0 0 12px;padding:0}
  .fenek-acrrf-v4-item{min-width:0;overflow:hidden;border:1px solid #cbdfe0;border-radius:11px;background:#fff}
  .fenek-acrrf-v4-photo{display:block;width:100%;aspect-ratio:3/2;background-size:300% 200%;background-position:var(--sprite-position);background-repeat:no-repeat;background-color:#f0f3f0}
  .fenek-acrrf-v4-item h5{font-size:clamp(.75rem,1.15vw,.9rem);line-height:1.45;padding:9px 10px 11px;margin:0;color:#153b52}
  .fenek-acrrf-v4-compare{font-size:.83rem;color:#075e51;text-decoration:underline;text-underline-offset:3px;font-weight:730}
  .fenek-acrrf-v4-original{margin:18px 0 12px;padding-top:14px;border-top:1px solid #c7ddd5;font-size:1rem;color:#153b52}
  :global(html[data-theme='dark']) .fenek-acrrf-v4{background:#173c3d;border-color:#397a69;color:#e0f5ed}
  :global(html[data-theme='dark']) .fenek-acrrf-v4-head h4,
  :global(html[data-theme='dark']) .fenek-acrrf-v4-original{color:#e2f4ee}
  :global(html[data-theme='dark']) .fenek-acrrf-v4-note{color:#c7e3dd}
  :global(html[data-theme='dark']) .fenek-acrrf-v4-item{background:#244450;border-color:#446b69}
  :global(html[data-theme='dark']) .fenek-acrrf-v4-item h5{color:#e4f6f4}
  :global(html[data-theme='dark']) .fenek-acrrf-v4-compare{color:#8cf3c6}
  @media(max-width:850px){.fenek-acrrf-v4-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:480px){.fenek-acrrf-v4-grid{grid-template-columns:minmax(0,1fr)}}
</style>
