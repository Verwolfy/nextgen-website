---
import {brand, type Lang, rangeName} from '../data/site';
import {existsSync} from 'node:fs';
import {join} from 'node:path';
import {catalogueProjects, conceptPackshot, packagingLabelFor, type CatalogueProject} from '../lib/catalogue-projets';
import {productWhatsappHref} from '../data/contact-channels';
import FenekApplicationGuide from './FenekApplicationGuide.astro';
import {reviewedV3GuideFor} from '../data/fenek-v3-reviewed';
import {c1tContent, c1tRequirements, c1tFamilyReferences, c1tComparativeCodes} from '../data/fenek-c1t-reference';

interface Props {lang: Lang; product: CatalogueProject;}
const {lang, product} = Astro.props;
if(product.code !== 'BOND-C1T') throw Error('C1T pilot must not render a different reference');
const t = c1tContent[lang];
const otherCodes=['BOND-C1T','BOND-C1TE','BOND-C2TE'] as const;
const comparison=otherCodes.map(code=>{
  const item=catalogueProjects.find(p=>p.code===code);
  if(!item) throw Error('Missing related BOND reference: '+code);
  return {item, meaning:c1tComparativeCodes[code][lang]};
});
const emailHref='mailto:'+brand.email+'?subject='+encodeURIComponent(t.documentAction+' — '+product.nom);
const image=conceptPackshot(product,'full');
const pdfHref=`/docs/fiches/fenek-bond-c1t-${lang}.pdf`;
const hasPublishedPdf=existsSync(join(process.cwd(),'public',pdfHref.slice(1)));
// Print uses the very same approved-for-editorial-display C1T six-scene
// WebP as the on-screen guide, not recreated or borrowed illustrations.
const c1tIllustratedGuide=reviewedV3GuideFor(product.code,product.slug);
if(!c1tIllustratedGuide)throw Error('Missing reviewed C1T application sequence');
const onlineHref=`https://nextgen-buildingsolutions.com/${lang}/documentation/${product.slug}/`;
// Offline-generated QR modules, EC level H, 4-module quiet zone. The link is
// selectable/clickable in exported PDF as well as scannable on paper.
const c1tQrRows:Record<Lang,string>={"fr":"","ar":"","en":""};
function qrPathFor(encoded:string):string{
  if(encoded.length!==49*13)throw Error('Invalid C1T QR module encoding');
  const segments:string[]=[];
  for(let row=0;row<49;row++){
    const mask=parseInt(encoded.slice(row*13,row*13+13),16);
    for(let col=0;col<49;){
      const on=Math.floor(mask/2**(48-col))%2===1;
      if(!on){col++;continue;}
      const begin=col;
      while(col<49 && Math.floor(mask/2**(48-col))%2===1)col++;
      segments.push(`M${begin+4} ${row+4}h${col-begin}v1h-${col-begin}Z`);
    }
  }
  return segments.join(' ');
}
const qrPath=qrPathFor(c1tQrRows[lang]);
const printCopy: Record<Lang,{
  documentType:string;descriptionTitle:string;description:string;overviewTitle:string;applicationsTitle:string;applications:string[];
  preparationTitle:string;preparation:string[];designationTitle:string;designation:{letter:string;meaning:string}[];
  requirementsTitle:string;thresholdTitle:string;tagline:string;methodTitle:string;method:string[];
  safetyTitle:string;safety:string[];contactTitle:string;classShort:string;packShort:string;edition:string;guideTitle:string;qrLabel:string;
}>={
  fr:{
    documentType:'FICHE PRODUIT',descriptionTitle:'Description du produit',
    description:'Mortier-colle cimentaire pour la pose de carreaux céramiques sur supports minéraux stables et préparés. Le choix du revêtement et de la méthode de pose dépend des conditions du chantier.',
    overviewTitle:'Aperçu',applicationsTitle:'Utilisations et supports',
    applications:['Carrelage et faïence sur murs et sols intérieurs, selon compatibilité.','Carreaux céramiques absorbants sur supports minéraux traditionnels.','Béton durci, chapes et enduits cimentaires cohésifs.'],
    preparationTitle:'Préparation du support',
    preparation:['Éliminer poussières, huiles, laitance et résidus non adhérents.','Contrôler cohésion, planéité et humidité du support.','Vérifier compatibilité et primaire sur supports particuliers.'],
    designationTitle:'Comprendre la désignation C1T',
    designation:[
      {letter:'C',meaning:'Mortier-colle à base de ciment.'},
      {letter:'1',meaning:'Adhérence de classe normale.'},
      {letter:'T',meaning:'Glissement vertical réduit.'}
    ],
    requirementsTitle:'Exigences de classement C1T',
    thresholdTitle:'Seuil de classe',
    tagline:'Mortier-colle cimentaire · Désignation C1T',
    methodTitle:'Mise en œuvre',
    method:['Gâcher selon la fiche du produit applicable.','Utiliser une spatule crantée adaptée.','Contrôler le transfert de colle à la pose.'],
    safetyTitle:'Sécurité et stockage',
    safety:['Porter gants, lunettes et protection contre les poussières.','Conserver au sec et consulter la FDS avant emploi.'],
    contactTitle:'Contact',classShort:'Classe',packShort:'Conditionnement',
    edition:'Éd. 18/11/2026',guideTitle:'GUIDE D’APPLICATION',qrLabel:'Consulter la fiche en ligne'
  },
  ar:{
    documentType:'بطاقة المنتج',descriptionTitle:'وصف المنتج',
    description:'مونة لاصقة إسمنتية لتركيب البلاط الخزفي على أسطح معدنية متماسكة ومهيأة. يتحدد اختيار البلاط وطريقة التركيب حسب ظروف موقع العمل.',
    overviewTitle:'نظرة عامة',applicationsTitle:'الاستخدامات والأسطح',
    applications:['تركيب البلاط على الجدران والأرضيات الداخلية وفق الملاءمة.','بلاط خزفي ماص على أسطح معدنية تقليدية.','خرسانة متصلبة وطبقات تسوية ولياسة إسمنتية متماسكة.'],
    preparationTitle:'تحضير السطح',
    preparation:['إزالة الغبار والزيوت والطبقات الضعيفة.','فحص تماسك السطح واستوائه ورطوبته.','التحقق من الملاءمة والبرايمر للأسطح الخاصة.'],
    designationTitle:'شرح التصنيف C1T',
    designation:[
      {letter:'C',meaning:'مونة لاصقة قائمة على الإسمنت.'},
      {letter:'1',meaning:'فئة الالتصاق العادي.'},
      {letter:'T',meaning:'انزلاق رأسي منخفض.'}
    ],
    requirementsTitle:'متطلبات تصنيف C1T',
    thresholdTitle:'حد التصنيف',
    tagline:'مونة لاصقة إسمنتية · تصنيف C1T',
    methodTitle:'طريقة التطبيق',
    method:['خلط المونة وفق نشرة المنتج المعتمد.','اختيار مالج مسنن مناسب.','التحقق من توزيع اللاصق خلف البلاط.'],
    safetyTitle:'السلامة والتخزين',
    safety:['ارتداء القفازات والنظارات وحماية من الغبار.','الحفظ في مكان جاف ومراجعة صحيفة السلامة.'],
    contactTitle:'التواصل',classShort:'الفئة',packShort:'العبوة',
    edition:'إصدار 18/11/2026',guideTitle:'دليل التطبيق',qrLabel:'عرض بطاقة المنتج على الموقع'
  },
  en:{
    documentType:'PRODUCT SHEET',descriptionTitle:'Product description',
    description:'Cementitious tile adhesive for ceramic tiling on sound, prepared mineral substrates. Tile selection and application method depend on the conditions of the project.',
    overviewTitle:'Overview',applicationsTitle:'Applications and substrates',
    applications:['Ceramic wall and floor tiling indoors, subject to compatibility.','Absorbent ceramic tiles on conventional mineral substrates.','Sound cured concrete, cement screeds and cement renders.'],
    preparationTitle:'Substrate preparation',
    preparation:['Remove dust, oil, laitance and loose material.','Check soundness, flatness and substrate moisture.','Verify compatibility and primer on special substrates.'],
    designationTitle:'Understanding the C1T designation',
    designation:[
      {letter:'C',meaning:'Cementitious tile adhesive.'},
      {letter:'1',meaning:'Normal adhesion class.'},
      {letter:'T',meaning:'Reduced vertical slip.'}
    ],
    requirementsTitle:'C1T classification requirements',
    thresholdTitle:'Class threshold',
    tagline:'Cementitious tile adhesive · C1T designation',
    methodTitle:'Application',
    method:['Mix according to the applicable product technical sheet.','Use an appropriate notched trowel.','Check adhesive transfer during installation.'],
    safetyTitle:'Safety and storage',
    safety:['Wear gloves, goggles and dust protection.','Store dry and consult the SDS before use.'],
    contactTitle:'Contact',classShort:'Class',packShort:'Packaging',
    edition:'Edition 18/11/2026',guideTitle:'APPLICATION GUIDE',qrLabel:'View the product sheet online'
  }
};
const p=printCopy[lang];
const schema={
  '@context':'https://schema.org',
  '@type':'Product',
  name:product.nom,
  description:t.lead,
  brand:{'@type':'Brand',name:'FENEK'},
  identifier:product.code,
  image:new URL(image, Astro.site ?? Astro.url).href,
  url:Astro.url.href
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<div class="page-head fenek-sheet-head" style={'--range-color:#12295C'}>
  <div class="container">
    <a class="concept-back" href={'/'+lang+'/catalogue/'}>{lang==='ar'?'العودة إلى الكتالوج':lang==='en'?'Back to catalogue':'Retour au catalogue'}</a>
    <span class="eyebrow">FENEK · BOND · C1T</span>
    <h1><bdi dir="ltr">{product.nom}</bdi></h1>
    <p>{t.lead}</p>
  </div>
</div>
<article class="fenek-product-page fenek-c1t-pilot" data-c1t-pilot data-reference={product.code}>
  <div class="container">
    <header class="fenek-product-intro">
      <div class="fenek-product-intro-copy">
        <span class="fenek-sheet-overline">{t.sheetTitle}</span>
        <h2>{t.introTitle}</h2>
        <p>{t.lead}</p>
        <ul class="fenek-product-quick-points">{t.benefits.map(point=><li>{point}</li>)}</ul>
      </div>
      <figure class="fenek-product-image">
        <img src={image} alt={t.sheetTitle} width="800" height="800" loading="eager" decoding="async" />
      </figure>
    </header>
    <nav class="fenek-section-nav" aria-label={lang==='ar'?'التنقل بين أقسام البطاقة':lang==='en'?'Product sheet sections':'Sections de la fiche'}>
      {['fenek-overview','fenek-details','fenek-application','fenek-documents'].map((id,i)=><a href={'#'+id}>{t.nav[i]}</a>)}
    </nav>
    <section id="fenek-overview" class="fenek-document-section" aria-labelledby="fenek-overview-heading">
      <h2 id="fenek-overview-heading">{t.nav[0]}</h2>
      <div class="fenek-overview-grid">
        <div><h3>{t.introTitle}</h3><ul>{t.uses.map(x=><li>{x}</li>)}</ul></div>
        <div><h3>{t.preparationTitle}</h3><ul>{t.substrates.map(x=><li>{x}</li>)}</ul></div>
        <div><h3>{t.identityTitle}</h3><dl class="fenek-document-data">
          <div><dt>{t.codeLabel}</dt><dd><bdi dir="ltr">{product.code}</bdi></dd></div>
          <div><dt>{t.packLabel}</dt><dd>{product.conditionnements.map(c=>packagingLabelFor(c.format,lang)).join(' · ')}</dd></div>
        </dl></div>
      </div>
    </section>
    <section id="fenek-details" class="fenek-document-section" aria-labelledby="fenek-details-heading">
      <h2 id="fenek-details-heading">{t.nav[1]}</h2>
      <h3>{t.identityTitle}</h3>
      <dl class="fenek-document-data c1t-identity">
        <div><dt>{t.designationLabel}</dt><dd><bdi dir="ltr">{product.nom}</bdi></dd></div>
        <div><dt>{t.rangeLabel}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
        <div><dt>{t.classLabel}</dt><dd><bdi dir="ltr">C1T — EN 12004-1:2017</bdi></dd></div>
      </dl>
      <h3>{t.techTitle}</h3>
      <div class="c1t-table-wrap">
        <table class="c1t-table"><thead><tr><th scope="col">{t.techTitle}</th><th scope="col">{lang==='ar'?'حد الفئة':lang==='en'?'Class threshold':'Seuil de classe'}</th></tr></thead>
          <tbody>{c1tRequirements.map(item=><tr data-c1t-source-type={item.kind}><th scope="row">{item.label[lang]}</th><td dir="ltr">{item.value}</td></tr>)}</tbody>
        </table>
      </div>
      <h3>{t.familyTitle}</h3>
      <div class="c1t-table-wrap"><table class="c1t-table"><thead><tr><th scope="col">{t.familyTitle}</th><th scope="col">{lang==='ar'?'القيمة المقارنة':lang==='en'?'Comparative value':'Valeur comparative'}</th></tr></thead>
        <tbody>{c1tFamilyReferences.map(item=><tr data-c1t-source-type={item.kind}><th scope="row">{item.label[lang]}</th><td dir="ltr">{item.value}</td></tr>)}</tbody>
      </table></div>
      <p class="c1t-table-note">{t.figuresNote}</p>
    </section>
    <section id="fenek-application" class="fenek-document-section" aria-labelledby="fenek-application-heading">
      <h2 id="fenek-application-heading">{t.applicationTitle}</h2>
      <div class="c1t-duo">
        <div><h3>{t.preparationTitle}</h3><ul>{t.preparation.map(x=><li>{x}</li>)}</ul></div>
        <div><h3>{t.conditionsTitle}</h3><ul>{t.conditions.map(x=><li>{x}</li>)}</ul></div>
      </div>
      <h3>{t.consumptionTitle}</h3>
      <div class="c1t-table-wrap"><table class="c1t-table"><tbody>
        {c1tFamilyReferences.filter(x=>x.key.startsWith('consommation-')||x.key==='eau').map(x=><tr><th scope="row">{x.label[lang]}</th><td dir="ltr">{x.value}</td></tr>)}
      </tbody></table></div>
      <p class="c1t-table-note">{t.figuresNote}</p>
      <h3>{t.stepsTitle}</h3>
      <FenekApplicationGuide lang={lang} product={product} concise />
      <h3>{t.safetyTitle}</h3>
      <ul class="c1t-safety">{t.safety.map(x=><li>{x}</li>)}</ul>
    </section>
    <section id="fenek-documents" class="fenek-document-section" aria-labelledby="fenek-documents-heading">
      <h2 id="fenek-documents-heading">{t.documentsTitle}</h2>
      <p>{t.sourceNote}</p>
      <div class="actions">
        {hasPublishedPdf ? <a class="btn" href={pdfHref} download>{t.downloadLabel}</a> : <button class="btn" type="button" data-print-market-sheet>{t.exportLabel}</button>}
        <a class="btn btn-muted" href={emailHref}>{t.documentAction}</a>
        <a class="btn btn-muted" href={'/'+lang+'/contact/'}>{t.quoteAction}</a>
        <a class="btn btn-muted" href={productWhatsappHref(lang,product,'documentation')} target="_blank" rel="noopener noreferrer">{t.whatsappAction}</a>
      </div>
    </section>
    <section class="fenek-document-section" aria-labelledby="c1t-compare-heading">
      <h2 id="c1t-compare-heading">{t.comparisonTitle}</h2>
      <p>{t.comparisonNote}</p>
      <div class="c1t-table-wrap"><table class="c1t-table"><thead><tr>{t.comparisonHeadings.map(x=><th scope="col">{x}</th>)}</tr></thead><tbody>
        {comparison.map(({item,meaning})=><tr><th scope="row"><a href={'/'+lang+'/documentation/'+item.slug+'/'}><bdi dir="ltr">{item.nom}</bdi></a></th><td dir="ltr">{item.code.replace('BOND-','')}</td><td>{meaning}</td></tr>)}
      </tbody></table></div>
      <h3>{t.relatedTitle}</h3>
      <div class="actions">{comparison.filter(({item})=>item.code!==product.code).map(({item})=><a class="btn btn-muted" href={'/'+lang+'/catalogue/'+item.slug+'/'}><bdi dir="ltr">{item.nom}</bdi></a>)}</div>
    </section>
  </div>
</article>
<section class="fenek-print-document fenek-c1t-print" lang={lang} dir={lang==='ar'?'rtl':'ltr'} data-c1t-technical-cover>
  <div class="fenek-print-masthead">
    <img class="fenek-print-logo" src="/images/Logo1.jpg" width="170" height="118" alt="NextGen Building Solutions" />
    <div class="fenek-print-name">NEXTGEN BUILDING SOLUTIONS</div>
    <div class="fenek-print-slants" aria-hidden="true"></div>
  </div>
  <div class="fenek-print-line" aria-hidden="true"></div>
  <div class="fenek-print-banner"><span>{p.documentType}</span></div>

  <header class="c1t-print-hero" data-print-hero>
    <div class="c1t-print-hero-copy">
      <div class="fenek-print-product-name"><bdi dir="ltr">{product.nom}</bdi></div>
      <p class="fenek-print-subtitle">{p.tagline}</p>
      <p class="c1t-print-standard" dir="ltr">EN 12004-1:2017</p>
      <dl class="c1t-print-identity">
        <div><dt>{t.codeLabel}</dt><dd><bdi dir="ltr">{product.code}</bdi></dd></div>
        <div><dt>{t.rangeLabel}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
        <div><dt>{p.classShort}</dt><dd><bdi dir="ltr">C1T</bdi></dd></div>
        <div><dt>{p.packShort}</dt><dd>{product.conditionnements.map(c=>packagingLabelFor(c.format,lang)).join(' · ')}</dd></div>
      </dl>
    </div>
    <figure class="fenek-print-packshot">
      <img src={image} width="800" height="800" alt={product.nom} />
    </figure>
  </header>

  <section class="fenek-print-card c1t-print-description" data-print-description>
    <h2>{p.descriptionTitle}</h2>
    <p>{p.description}</p>
  </section>

  <section class="fenek-print-card c1t-print-overview" data-print-overview>
    <h2>{p.overviewTitle}</h2>
    <div class="c1t-print-columns">
      <div>
        <h3>{p.applicationsTitle}</h3>
        <ul>{p.applications.map(text=><li>{text}</li>)}</ul>
      </div>
      <div>
        <h3>{p.preparationTitle}</h3>
        <ul>{p.preparation.map(text=><li>{text}</li>)}</ul>
      </div>
    </div>
  </section>

  <div class="c1t-print-technical-pair">
    <section class="fenek-print-card c1t-print-designation" data-print-designation>
      <h2>{p.designationTitle}</h2>
      <dl>
        {p.designation.map(entry=><div>
          <dt dir="ltr">{entry.letter}</dt><dd>{entry.meaning}</dd>
        </div>)}
      </dl>
    </section>
    <section class="fenek-print-card c1t-print-requirements" data-print-standards>
      <h2>{p.requirementsTitle}</h2>
      <table class="c1t-print-table">
        <thead><tr>
          <th scope="col">{lang==='ar'?'الخاصية':lang==='en'?'Characteristic':'Caractéristique'}</th>
          <th scope="col">{p.thresholdTitle}</th>
        </tr></thead>
        <tbody>{c1tRequirements.map(x=><tr><th scope="row">{x.label[lang]}</th><td dir="ltr">{x.value}</td></tr>)}</tbody>
      </table>
    </section>
  </div>

  <div class="c1t-print-bottom">
    <section class="fenek-print-card c1t-print-method" data-print-method>
      <h2>{p.methodTitle}</h2><ul>{p.method.map(text=><li>{text}</li>)}</ul>
    </section>
    <section class="fenek-print-card c1t-print-safety" data-print-safety>
      <h2>{p.safetyTitle}</h2><ul>{p.safety.map(text=><li>{text}</li>)}</ul>
    </section>
    <section class="fenek-print-card c1t-print-contact" data-print-contact>
      <h2>{p.contactTitle}</h2>
      <strong>NEXTGEN BUILDING SOLUTIONS</strong>
      <span>{brand.email}</span>
      <span>nextgen-buildingsolutions.com</span>
    </section>
  </div>

  <div class="fenek-print-footer c1t-print-footer">
    <span>{product.code} · {p.edition} · {lang.toUpperCase()}</span>
  </div>

</section>
<section class="fenek-print-document fenek-c1t-guide-print" lang={lang}
  dir={lang==='ar'?'rtl':'ltr'} data-c1t-application-page
  data-c1t-guide-src={c1tIllustratedGuide.sprite}>
  <div class="fenek-print-masthead">
    <img class="fenek-print-logo" src="/images/Logo1.jpg" width="170" height="118" alt="NextGen Building Solutions" />
    <div class="fenek-print-name">NEXTGEN BUILDING SOLUTIONS</div>
    <div class="fenek-print-slants" aria-hidden="true"></div>
  </div>
  <div class="fenek-print-line" aria-hidden="true"></div>
  <div class="fenek-print-banner"><span>{p.guideTitle}</span></div>
  <h2 class="c1t-print-guide-product"><bdi dir="ltr">{product.nom}</bdi></h2>

  <ol class="c1t-print-guide-steps" data-c1t-guide-steps>
    {c1tIllustratedGuide.steps.map((step,i)=><li class="c1t-print-guide-step" data-c1t-guide-step={i+1}>
      <h3><bdi dir="ltr">{String(i+1).padStart(2,'0')}</bdi> {step.title[lang]}</h3>
      <div class="c1t-print-guide-art" role="img"
        aria-label={step.title[lang]}
        style={`background-image:url('${c1tIllustratedGuide.sprite}');background-position:${((step.image-1)%3)*50}% ${Math.floor((step.image-1)/3)*100}%`}
        data-illustration-index={step.image}></div>
      <p>{step.description[lang]}</p>
    </li>)}
  </ol>

  <footer class="c1t-print-guide-footer">
    <a href={onlineHref} class="c1t-print-guide-qr-link" data-c1t-qr-href={onlineHref}>
      <svg class="c1t-print-guide-qr" viewBox="0 0 57 57"
        xmlns="http://www.w3.org/2000/svg" aria-label={p.qrLabel}
        role="img" shape-rendering="crispEdges">
        <rect width="57" height="57" fill="#fff" />
        <path d={qrPath} fill="#000" />
      </svg>
      <strong>{p.qrLabel}</strong>
      <span dir="ltr">nextgen-buildingsolutions.com/{lang}</span>
    </a>
    <div class="c1t-print-guide-page"><bdi dir="ltr">{product.code} · {lang.toUpperCase()} · 02 / 02</bdi></div>
  </footer>
</section>
<style>
  .fenek-c1t-pilot .fenek-document-section h3{font-size:clamp(1.15rem,2vw,1.35rem);margin:20px 0 12px}
  .fenek-c1t-pilot .fenek-document-section ul{padding-inline-start:1.4rem}
  .fenek-c1t-pilot .fenek-document-section li{margin-block:5px}
  .c1t-table-wrap{overflow-x:auto;max-width:100%}
  .c1t-table{border-collapse:collapse;width:100%;font-size:.94rem;margin:12px 0 22px}
  .c1t-table th,.c1t-table td{padding:11px 15px;text-align:start;border-bottom:1px solid #dce7e7;vertical-align:top}
  .c1t-table thead{background:#103651;color:white}
  .c1t-table tbody th{font-weight:600}
  .c1t-table tbody tr:nth-child(even){background:#f2f7f5}
  .c1t-table td[dir="ltr"]{white-space:nowrap;font-variant-numeric:tabular-nums}
  .c1t-table a{text-decoration:underline;text-decoration-color:#078d62;text-underline-offset:4px}
  .c1t-table-note{font-size:.9rem;color:#45616f}
  .c1t-duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
