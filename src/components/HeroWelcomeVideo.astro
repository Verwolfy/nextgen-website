---
import type { Lang } from '../data/site';
import { homeV3Copy } from '../data/home-v3';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const motion = homeV3Copy[lang];
const i18n = {
  fr: {
    label: 'Nexo et Geno vous invitent à découvrir NextGen',
    cta: 'Découvrir les produits NextGen',
    pause: 'Mettre la vidéo en pause',
    play: 'Relancer la vidéo',
  },
  ar: {
    label: 'نيكسو وجينو يدعوانكم لاكتشاف منتجات NextGen',
    cta: 'اكتشفوا منتجات NextGen',
    pause: 'إيقاف الفيديو مؤقتًا',
    play: 'تشغيل الفيديو',
  },
  en: {
    label: 'Nexo and Geno invite you to discover NextGen',
    cta: 'Discover NextGen products',
    pause: 'Pause video',
    play: 'Play video',
  },
}[lang];
---
<div class="welcome-video-card" data-welcome-card aria-label={i18n.label} role="region">
  <div class="welcome-video-overline"><span><span class="welcome-video-indicator" aria-hidden="true"></span>{motion.motionLabel}</span><span>{motion.motionDuration}</span></div>
  <video
    data-welcome-video
    data-src="/videos/nextgen-nexo-geno-welcome.mp4?v=20261105-v3"
    class="welcome-video"
    poster="/videos/nextgen-nexo-geno-poster.webp?v=20261105-v3"
    width="960" height="540"
    preload="none"
    muted playsinline loop
    aria-hidden="true"
  ></video>
  <div class="welcome-video-actions">
    <button type="button" data-welcome-toggle aria-label={i18n.pause} data-label-play={i18n.play} data-label-pause={i18n.pause} hidden>Ⅱ</button>
  </div>
  <a class="welcome-video-cta" href={`/${lang}/catalogue/`}>{i18n.cta}</a>
</div>
<script>
  const card = document.querySelector<HTMLElement>('[data-welcome-card]');
  const video = card?.querySelector<HTMLVideoElement>('[data-welcome-video]');
  const button = card?.querySelector<HTMLButtonElement>('[data-welcome-toggle]');
  if (card && video && button && 'IntersectionObserver' in window) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let userChoice: 'auto'|'paused'|'playing' = 'auto';
    if (reduceMotion.matches) {
      button.textContent = '▶';
      button.setAttribute('aria-label', button.dataset.labelPlay!);
    }
    const sync = async () => {
      const shouldPlay = visible && !document.hidden && userChoice !== 'paused'
        && (!reduceMotion.matches || userChoice === 'playing');
      // Keep the accessible label in sync when reduced motion or visibility changes.
      button.textContent = shouldPlay ? 'Ⅱ' : '▶';
      button.setAttribute('aria-label', shouldPlay ? button.dataset.labelPause! : button.dataset.labelPlay!);
      if (!shouldPlay) { video.pause(); return; }
      if (!video.src) video.src = video.dataset.src || '';
      try { await video.play(); } catch { /* Poster remains visible */ }
    };
    const observer = new IntersectionObserver(entries => {
      visible = entries.some(entry => entry.isIntersecting);
      void sync();
    }, { rootMargin: '100px' });
    observer.observe(card);
    button.hidden = false;
    button.addEventListener('click', () => {
      const requestPause = userChoice === 'playing' || (userChoice === 'auto' && !reduceMotion.matches);
      userChoice = requestPause ? 'paused' : 'playing';
      button.textContent = requestPause ? '▶' : 'Ⅱ';
      button.setAttribute('aria-label', requestPause ? button.dataset.labelPlay! : button.dataset.labelPause!);
      void sync();
    });
    document.addEventListener('visibilitychange', () => { void sync(); });
    reduceMotion.addEventListener('change', () => { void sync(); });
  }
</script>
<style>
  .welcome-video-card{
    width:min(100%,560px);min-width:0;margin-inline:auto;padding:0;overflow:hidden;
    background:#f8faf8;border:1px solid #a6cfc2a8;border-radius:15px;
    box-shadow:0 27px 70px #00121e88;color:#102e3a;
  }
  .welcome-video-overline{
    min-height:45px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;
    flex-wrap:wrap;gap:7px;background:#092735;color:#d8f2e8;font-size:.64rem;
    letter-spacing:.075em;line-height:1.4;font-weight:840;
  }
  .welcome-video-overline>span:first-child{display:flex;align-items:center;gap:9px}
  .welcome-video-overline>span:last-child{font-weight:640;color:#a9c6c5;letter-spacing:0}
  .welcome-video-indicator{height:9px;width:9px;border:2px solid #6ee5b0;border-radius:100%;box-shadow:0 0 0 4px #6ee5b01b;flex:none}
  .welcome-video{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain;background:#f4f6f4}
  .welcome-video-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;min-height:48px;padding:7px 15px;background:#f8faf8}
  [data-welcome-toggle]{min-width:43px;min-height:43px;background:#0e3140;border:1px solid #0e3140;border-radius:100px;color:#fff;cursor:pointer;font-size:1rem}
  [data-welcome-toggle]:hover{background:#1a5552}
  .welcome-video-cta{display:block;width:100%;text-align:center;background:#daf3e7;color:#0b503a;border-top:1px solid #c9e4d8;padding:13px 12px;font-size:.85rem;font-weight:850}
  .welcome-video-cta:hover{background:#b8efd7;text-decoration:none;color:#09412f}
  .welcome-video-card button:focus-visible,.welcome-video-cta:focus-visible{outline:3px solid #086b50;outline-offset:-3px}
  @media(max-width:580px){.welcome-video-overline{padding:9px 12px;font-size:.59rem}.welcome-video-actions{min-height:44px;padding:5px 12px}[data-welcome-toggle]{min-width:42px;min-height:42px}}
  @media(prefers-reduced-motion:reduce){.welcome-video{animation:none;transition:none}}
</style>