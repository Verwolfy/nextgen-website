---
import type { Lang } from '../data/site';
import { tickerContent } from '../data/nextgen-ticker';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const ticker = tickerContent[lang];
const currentDate = new Date().toISOString().slice(0,10);
const freshItems = ticker.items.filter(item => item.expires >= currentDate);
const i18n = {
  fr: {
    label: 'Nexo et Geno vous invitent à découvrir NextGen',
    cta: 'Découvrir les produits NextGen',
    pause: 'Mettre la vidéo en pause',
    play: 'Relancer la vidéo',
  },
  ar: {
    label: 'نيكسو وجينو يدعوانكم لاكتشاف منتجات NextGen',
    cta: 'اكتشفوا منتجات NextGen',
    pause: 'إيقاف الفيديو مؤقتًا',
    play: 'تشغيل الفيديو',
  },
  en: {
    label: 'Nexo and Geno invite you to discover NextGen',
    cta: 'Discover NextGen products',
    pause: 'Pause video',
    play: 'Play video',
  },
}[lang];
---
<div class="welcome-video-card" dir={lang === 'ar' ? 'rtl' : 'ltr'} data-welcome-card aria-label={i18n.label} role="region">
  <video
    data-welcome-video
    data-src="/videos/nextgen-nexo-geno-welcome.mp4?v=20261105-v3"
    class="welcome-video"
    poster="/videos/nextgen-nexo-geno-poster.webp?v=20261105-v3"
    width="960" height="540"
    preload="none"
    muted playsinline loop
    aria-hidden="true"
  ></video>
  <div class="welcome-video-actions">
    <div class="welcome-news-ticker" data-news-ticker role="region" aria-label={ticker.label}>
      <div class="welcome-news-viewport">
        <div class="welcome-news-track">
          <span class="welcome-news-group" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
            {freshItems.map(item => <span class="welcome-news-item" data-news-expires={item.expires}><span class="welcome-news-category">{item.category}</span><span>{item.text}</span><small>{item.source} · {item.date}</small></span>)}
          </span>
          <span class="welcome-news-group welcome-news-duplicate" aria-hidden="true">
            {freshItems.map(item => <span class="welcome-news-item" data-news-expires={item.expires}><span class="welcome-news-category">{item.category}</span><span>{item.text}</span><small>{item.source} · {item.date}</small></span>)}
          </span>
        </div>
      </div>
      <span class="welcome-news-fallback" data-news-fallback hidden>{ticker.fallback}</span>
    </div>
    <button type="button" data-welcome-toggle aria-label={i18n.pause} data-label-play={i18n.play} data-label-pause={i18n.pause} hidden>Ⅱ</button>
  </div>
  <a class="welcome-video-cta" href={`/${lang}/catalogue/`}>{i18n.cta}</a>
</div>
<script>
  // Client expiry gate also protects already-deployed static HTML from going stale.
  const news = document.querySelector<HTMLElement>('[data-news-ticker]');
  const refreshNews = () => {
    if (!news) return;
    const today = new Date().toISOString().slice(0,10);
    const items = news.querySelectorAll<HTMLElement>('[data-news-expires]');
    items.forEach(item => { item.hidden = (item.dataset.newsExpires || '') < today; });
    const visible = news.querySelectorAll('.welcome-news-group:first-child .welcome-news-item:not([hidden])').length;
    const track = news.querySelector<HTMLElement>('.welcome-news-track');
    const fallback = news.querySelector<HTMLElement>('[data-news-fallback]');
    if (track) track.hidden = visible === 0;
    if (fallback) fallback.hidden = visible !== 0;
  };
  refreshNews();
  document.addEventListener('visibilitychange',refreshNews);
  const card = document.querySelector<HTMLElement>('[data-welcome-card]');
  const video = card?.querySelector<HTMLVideoElement>('[data-welcome-video]');
  const button = card?.querySelector<HTMLButtonElement>('[data-welcome-toggle]');
  if (card && video && button && 'IntersectionObserver' in window) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let userChoice: 'auto'|'paused'|'playing' = 'auto';
    // Data Saver and reduced-motion visitors see the poster until they opt in.
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
    const autoAllowed = () => !reduceMotion.matches && !saveData;
    const syncButton = () => {
      const intendsPlay = userChoice === 'playing' || (userChoice === 'auto' && autoAllowed());
      button.textContent = intendsPlay ? 'Ⅱ' : '▶';
      button.setAttribute('aria-label', intendsPlay ? button.dataset.labelPause! : button.dataset.labelPlay!);
    };
    syncButton();
    const sync = async () => {
      syncButton();
      const shouldPlay = visible && !document.hidden && userChoice !== 'paused'
        && (autoAllowed() || userChoice === 'playing');
      if (!shouldPlay) { video.pause(); return; }
      if (!video.src) video.src = video.dataset.src || '';
      try { await video.play(); } catch { /* Poster remains visible */ }
    };
    const observer = new IntersectionObserver(entries => {
      visible = entries.some(entry => entry.isIntersecting);
      void sync();
    }, { rootMargin: '100px' });
    observer.observe(card);
    button.hidden = false;
    button.addEventListener('click', () => {
      const requestPause = userChoice === 'playing' || (userChoice === 'auto' && autoAllowed());
      userChoice = requestPause ? 'paused' : 'playing';
      void sync();
    });
    document.addEventListener('visibilitychange', () => { void sync(); });
    reduceMotion.addEventListener('change', () => { void sync(); });
  }
</script>
<style>
  .welcome-video-card{
    width:min(100%,560px);min-width:0;margin-inline:auto;padding:0;overflow:hidden;
    background:#f8faf8;border:1px solid #a6cfc2a8;border-radius:15px;
    box-shadow:0 27px 70px #00121e88;color:#102e3a;
  }
  .welcome-video{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain;background:#f4f6f4}
  .welcome-video-actions{display:flex;align-items:center;gap:10px;min-height:62px;padding:7px 12px;background:#f8faf8}
  .welcome-news-ticker{flex:1;min-width:0;color:#103b40}
  .welcome-news-viewport{overflow:hidden;position:relative}
  .welcome-news-track{display:flex;width:max-content;align-items:center;animation:welcome-news-scroll 48s linear infinite}
  .welcome-news-group{display:flex;align-items:center;gap:32px;flex:none;padding-inline-end:32px}
  .welcome-news-item{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;font-size:.74rem;color:#153e42;text-decoration:none}
    .welcome-news-category{font-size:.65rem;font-weight:800;text-transform:uppercase;color:#086947}
  .welcome-news-item small{color:#5b6c6d;font-size:.64rem}
  .welcome-news-ticker:hover .welcome-news-track,.welcome-news-ticker:focus-within .welcome-news-track{animation-play-state:paused}
  @keyframes welcome-news-scroll{to{transform:translateX(-50%)}}
  .welcome-video-card[dir="rtl"] .welcome-news-track{animation-direction:reverse}
  .welcome-news-item[hidden],.welcome-news-track[hidden],.welcome-news-fallback[hidden]{display:none}
  .welcome-news-fallback{font-size:.72rem;color:#526c70}
  @media(prefers-reduced-motion:reduce){.welcome-news-track{animation:none;width:auto}.welcome-news-viewport{overflow-x:auto}.welcome-news-duplicate{display:none}}

  [data-welcome-toggle]{min-width:43px;min-height:43px;background:#0e3140;border:1px solid #0e3140;border-radius:100px;color:#fff;cursor:pointer;font-size:1rem}
  [data-welcome-toggle]:hover{background:#1a5552}
  .welcome-video-cta{display:block;width:100%;text-align:center;background:#daf3e7;color:#0b503a;border-top:1px solid #c9e4d8;padding:13px 12px;font-size:.85rem;font-weight:850}
  .welcome-video-cta:hover{background:#b8efd7;text-decoration:none;color:#09412f}
  .welcome-video-card button:focus-visible,.welcome-video-cta:focus-visible{outline:3px solid #086b50;outline-offset:-3px}
  @media(max-width:580px){.welcome-video-actions{min-height:55px;padding:5px 9px}[data-welcome-toggle]{min-width:42px;min-height:42px}.welcome-news-item{font-size:.7rem}}
  @media(prefers-reduced-motion:reduce){.welcome-video{animation:none;transition:none}}
</style>