---
import { brand, type Lang } from '../data/site';
import { contactCopy } from '../data/contact-channels';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = contactCopy[lang];
const phone = 'tel:' + brand.phone.replaceAll(' ', '');
const email = 'mailto:' + brand.email;
const whatsapp = 'https://wa.me/' + brand.whatsapp;
---
<section class="contact-direct" id="contact-direct" aria-labelledby="contact-direct-title">
  <div class="section-head">
    <h2 id="contact-direct-title">{t.heading}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="contact-channels">
    <article class="contact-channel">
      <span class="contact-channel-kind">{t.emailTitle}</span>
      <p class="contact-channel-value" dir="ltr">{brand.email}</p>
      <a class="btn" href={email}>{t.emailAction}<span aria-hidden="true"> ↗</span></a>
    </article>
    <article class="contact-channel">
      <span class="contact-channel-kind">{t.whatsappTitle}</span>
      <p class="contact-channel-value" dir="ltr">{brand.phone}</p>
      <a class="btn" href={whatsapp} target="_blank" rel="noopener noreferrer">
        {t.whatsappAction}<span aria-hidden="true"> ↗</span>
      </a>
    </article>
    <article class="contact-channel">
      <span class="contact-channel-kind">{t.phoneTitle}</span>
      <p class="contact-channel-value" dir="ltr">{brand.phone}</p>
      <a class="btn btn-muted" href={phone}>{t.phoneAction}</a>
    </article>
  </div>
  <div class="contact-disclosure" role="note">
    <p>{t.externalNotice}</p>
    <p>{t.inboxNotice}</p>
  </div>
</section>
