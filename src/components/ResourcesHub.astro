---
import { messages, type Lang } from '../data/site';
import { editorialCopy } from '../data/editorial';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang];
const edit = editorialCopy[lang];
const visuals = {
  fr: 'Voir aussi les 46 illustrations de conception (2D)',
  ar: 'شاهد أيضاً 46 صورة للتصاميم الأولية (ثنائية الأبعاد)',
  en: 'Also explore 46 visual design concepts (2D)',
}[lang];
const contactAction = {
  fr: 'Demander une documentation',
  ar: 'طلب الوثائق الفنية',
  en: 'Request documentation',
}[lang];
---
<section aria-labelledby="resources-heading">
  <div class="section-head"><h2 id="resources-heading">{edit.resourceHeading}</h2><p>{edit.resourceLead}</p></div>
  <div class="resources-grid resources-grid-docs">
    <article class="resource-card">
      <span class="resource-index" aria-hidden="true">01</span>
      <span class="resource-state">{edit.resourcePending}</span>
      <h3>{edit.resourceTechTitle}</h3><p>{edit.resourceTechInfo}</p>
    </article>
    <article class="resource-card">
      <span class="resource-index" aria-hidden="true">02</span>
      <span class="resource-state">{edit.resourcePending}</span>
      <h3>{edit.resourceSafetyTitle}</h3><p>{edit.resourceSafetyInfo}</p>
    </article>
  </div>
  <div class="resource-support">
    <p class="editorial-caution" role="note">{t.noDocuments}</p>
    <div class="actions">
      <a class="btn" href={`/${lang}/contact/`}>{contactAction}</a>
      <a class="resource-gallery-link" href={`/${lang}/maquettes/`}>{visuals}</a>
    </div>
  </div>
</section>
