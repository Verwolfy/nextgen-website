---
/**
 * Editorial application walkthrough, not a validated technical data sheet.
 * Every FENEK reference renders its own verified six-scene remastered WebP.
 */
import type { Lang } from '../data/site';
import type { CatalogueProject } from '../lib/catalogue-projets';
import { applicationContextFor } from '../data/fenek-application-context';
import { reviewedV3GuideFor } from '../data/fenek-v3-reviewed';
import enhancedArtwork from '../data/fenek-enhanced-artwork.json';
interface Props { lang:Lang; product:CatalogueProject; }
const {lang,product}=Astro.props;
const reviewedV3=reviewedV3GuideFor(product.code,product.slug);
const enhancedV3=enhancedArtwork.find(item=>item.code===product.code && item.slug===product.slug);
// Fail the static build rather than publishing another product's illustration.
if(!reviewedV3 || !enhancedV3 || enhancedV3.sprite!==reviewedV3.sprite || enhancedV3.sha256!==reviewedV3.sha256)
  throw Error('FENEK illustration missing or mismatched: '+product.code);
const steps=reviewedV3.steps.map(step=>({title:step.title[lang],description:step.description[lang],icon:step.icon,image:step.image}));
// Draft illustration previews belong in an isolated, noindex review gallery.
// Official FR/EN/AR product guides must show their current six steps only.
const fullSizeC1T=product.code==='BOND-C1T' && product.slug==='fenek-bond-c1t' ? [
 '/images/illustrations/application/v3/fenek-bond-c1t/01_support.png',
 '/images/illustrations/application/v3/fenek-bond-c1t/02_epi.png',
 '/images/illustrations/application/v3/fenek-bond-c1t/03_gachage.png',
 '/images/illustrations/application/v3/fenek-bond-c1t/04_repos.png',
 '/images/illustrations/application/v3/fenek-bond-c1t/05_encollage.png',
 '/images/illustrations/application/v3/fenek-bond-c1t/06_pose.png',
] : null;

const copy={
  fr:{intro:'Parcours illustré de mise en œuvre',step:'Étape',alert:'Mode opératoire indicatif — présentation provisoire',warning:'Ces schémas expliquent les gestes de métier ; ils ne remplacent pas une FT/FDS FENEK approuvée. Ne déduisez jamais de ces illustrations un dosage, un temps ouvert, une épaisseur ou une résistance.',check:'Point spécifique à vérifier pour cette référence',photo:'Illustration fournie par le client',zoom:'Ouvrir en haute résolution'},
  en:{intro:'Illustrated application journey',step:'Step',alert:'Indicative process — provisional presentation',warning:'These images illustrate general trade practice, not an approved FENEK TDS/SDS. Never infer ratios, open time, thickness or strength from drawings.',check:'Reference-specific verification',photo:'Customer-provided illustration',zoom:'Open full-resolution illustration'},
  ar:{intro:'مراحل التطبيق المصورة',step:'المرحلة',alert:'إجراء إرشادي — عرض أولي',warning:'هذه الرسوم توضح خطوات العمل العامة ولا تحل محل النشرة الفنية ونشرة السلامة المعتمدتين. لا تستنتج نسب الخلط أو أوقات التشغيل أو السماكة أو المقاومة من الصور.',check:'نقطة فحص خاصة بهذا المرجع',photo:'رسم مقدم من العميل',zoom:'فتح الرسم بالحجم الكامل'}
}[lang];

---
<section class="fenek-application-visual" aria-label={copy.intro} data-application-visual data-reference={product.code} data-application-count={steps.length} data-v3-reviewed={reviewedV3.status} data-v3-sprite={enhancedV3.sprite} data-v3-hash={enhancedV3.sha256} data-v3-enhanced-sprite={enhancedV3.sprite} data-v3-enhanced-hash={enhancedV3.sha256}>
  <div class="fenek-application-visual-heading">
    <span class="fenek-application-visual-eyebrow">{product.nom}</span>
    <h3>{copy.intro}</h3>
    <span class="fenek-application-visual-tag">{steps.length} {copy.step.toLowerCase()}</span>
  </div>
  <ol class="fenek-application-visual-grid has-drawings v3-reviewed">
    {steps.map((step,i)=><li class="fenek-application-visual-card" data-application-step={i+1}>
      <figure class="fenek-application-visual-figure fenek-v3-upgraded-figure">
        <div class="fenek-application-visual-photo fenek-v3-reviewed-photo fenek-v3-upgraded-photo"
          style={`--sprite-position:${((step.image-1)%3)*50}% ${Math.floor((step.image-1)/3)*100}%;--v3-sprite:url('${enhancedV3.sprite}')`}
          data-v3-step={i+1}
          role="img" aria-label={product.nom+' — '+copy.step+' '+(i+1)+': '+step.title}></div>
        <figcaption>{String(i+1).padStart(2,'0')}</figcaption>
      </figure>
      <div class="fenek-application-visual-copy">
        <h4>{step.title}</h4>
        <p>{step.description}</p>
        {fullSizeC1T?.[i] && <a class="fenek-v3-detail-link"
          href={fullSizeC1T[i]} target="_blank" rel="noopener noreferrer"
          aria-label={copy.zoom+' — '+product.nom+' — '+copy.step+' '+(i+1)}>
          {copy.zoom}
        </a>}
      </div>
    </li>)}
  </ol>
  <div class="fenek-application-visual-attention" role="note">
    <strong>{copy.check} — <bdi dir="ltr">{product.nom}</bdi></strong>
    <p>{applicationContextFor(product.code,lang)}</p>
  </div>
  <p class="fenek-application-visual-warning"><strong>{copy.alert}.</strong> {copy.warning}</p>
</section>
<style>
 .fenek-application-visual{--ink:#113651;--accent:#07895e;margin:0 0 18px}
 .fenek-application-visual-heading{display:flex;align-items:center;gap:10px 15px;flex-wrap:wrap;margin:0 0 19px}
 .fenek-application-visual-heading h3{margin:0;flex:1 1 320px;color:var(--ink);font-size:clamp(1.12rem,2vw,1.45rem)}
 .fenek-application-visual-eyebrow{flex-basis:100%;font-size:.74rem;letter-spacing:.08em;font-weight:820;color:#09875c}
 .fenek-application-visual-tag{white-space:nowrap;border-radius:40px;background:#e7f4ee;color:#075f4e;font-weight:750;font-size:.75rem;padding:6px 12px}
 .fenek-application-visual-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:0;margin:0;list-style:none}
 .fenek-application-visual-grid.has-drawings{grid-template-columns:repeat(3,minmax(0,1fr))}
 .fenek-application-visual-card{display:flex;flex-direction:column;overflow:hidden;min-width:0;border:1px solid #d8e5e6;border-radius:14px;background:linear-gradient(165deg,#fff 66%,#f3faf7);box-shadow:0 4px 16px #1136510a;break-inside:avoid}
 .fenek-application-visual-figure{position:relative;display:grid;place-items:center;min-height:125px;margin:0;background:#f6faf9;border-bottom:1px solid #e1ebe8;overflow:hidden}
 .fenek-application-visual-figure figcaption{position:absolute;top:10px;inset-inline-start:12px;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#12365b;color:white;font-size:.78rem;font-weight:850;box-shadow:0 3px 8px #08284320}
 .fenek-application-visual-photo{width:min(100%,142px);aspect-ratio:1;background-repeat:no-repeat;background-size:300% 200%;background-position:var(--sprite-position);filter:contrast(1.04)}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-card{background:#fff}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-figure{aspect-ratio:1/1;min-height:0;background:#fff;border-bottom:0;padding:3px}
 .fenek-application-visual-grid.v3-reviewed .fenek-v3-detail-link{display:inline-block;width:auto;max-width:100%;aspect-ratio:auto;margin-top:8px;padding:6px 9px;border-radius:8px;background:#e7f4ee;color:#075f4e;font-weight:750;font-size:.76rem;text-decoration:underline;text-underline-offset:2px;cursor:zoom-in}
 .fenek-v3-detail-link:focus-visible{outline:3px solid #009a44;outline-offset:-4px;border-radius:8px}
 .fenek-v3-detail-link:hover .fenek-v3-reviewed-photo{filter:contrast(1.08)}
 .fenek-v3-reviewed-photo{width:100%;aspect-ratio:1;max-width:none;background-image:var(--v3-sprite);background-size:300% 200%;background-position:var(--sprite-position);background-repeat:no-repeat;filter:none}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-figure figcaption{display:none}
 /* Crop only text baked into a source sprite when the upper artwork is pixel-identical to this product's V3 PNGs. */
 /* Artworks are intentionally caption-free: titles remain selectable, translated HTML outside the image. */
 .fenek-application-visual-grid.v3-reviewed .fenek-v3-upgraded-figure{aspect-ratio:3/2}
 .fenek-application-visual-grid.v3-reviewed .fenek-v3-upgraded-photo{aspect-ratio:3/2}
 /* Source V3 includes baked AR/FR captions. QA-certified upper illustration crop prevents duplication and incorrect language. */
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-copy{border-top:1px solid #e6efeb;padding:9px 13px 15px}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-copy h4{font-size:.89rem}
 .fenek-application-visual-icon svg{height:58px;width:58px}
 .fenek-application-visual-copy{padding:15px 16px 18px;flex:1}
 .fenek-application-visual-copy h4{font-size:1rem;line-height:1.32;margin:0 0 8px;color:#133853}
 .fenek-application-visual-copy p{margin:0;color:#425d68;font-size:.85rem;line-height:1.64;max-width:none}
 .fenek-application-visual-attention{margin-top:18px;padding:14px 18px;border-radius:12px;background:#ecf6f2;border-inline-start:4px solid #00885d}
 .fenek-application-visual-attention strong{color:#174456;font-size:.9rem}
 .fenek-application-visual-attention p{margin:5px 0 0;font-size:.85rem;color:#395c66;line-height:1.7}
 .fenek-application-visual-warning{margin:13px 0 0;padding:10px 13px;background:#f8f8f2;border:1px solid #e4e3d2;border-radius:8px;color:#465e64;font-size:.82rem;line-height:1.55;max-width:none}
 :global(html[data-theme='dark']) .fenek-application-visual{--ink:#e7f5fb}
 :global(html[data-theme='dark']) .fenek-application-visual-card{background:linear-gradient(160deg,#183749,#123042);border-color:#436075}
 :global(html[data-theme='dark']) .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-card{background:#183749}
 :global(html[data-theme='dark']) .fenek-application-visual-figure{background:#204354;border-color:#496b74}
 :global(html[data-theme='dark']) .fenek-application-visual-copy h4{color:#f0fafc}
 :global(html[data-theme='dark']) .fenek-application-visual-copy p{color:#c5dae5}
 :global(html[data-theme='dark']) .fenek-application-visual-heading h3{color:#e8f6fa}
 :global(html[data-theme='dark']) .fenek-application-visual-attention{background:#1c4b47;border-color:#45c69a}
 :global(html[data-theme='dark']) .fenek-application-visual-attention strong,:global(html[data-theme='dark']) .fenek-application-visual-attention p{color:#deeee7}
 :global(html[data-theme='dark']) .fenek-application-visual-warning{background:#283b40;border-color:#5c675c;color:#edf0e5}
 :global(html[data-theme='dark']) .fenek-application-visual-tag{background:#206450;color:#eafff1}
 :global(html[data-theme='dark']) .fenek-application-visual-eyebrow{color:#68dda7}
 @media(max-width:870px){.fenek-application-visual-grid.has-drawings{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:550px){.fenek-application-visual-grid,.fenek-application-visual-grid.has-drawings{grid-template-columns:1fr}
 .fenek-application-visual-card{display:grid;grid-template-columns:116px minmax(0,1fr);min-height:137px}
 .fenek-application-visual-figure{min-height:135px;border-bottom:0;border-inline-end:1px solid #e2eae8}
 .fenek-application-visual-figure figcaption{inset-inline-start:6px;top:7px;width:25px;height:25px;font-size:.67rem}
 .fenek-application-visual-photo{width:113px}
 .fenek-application-visual-icon svg{width:45px;height:45px}
 .fenek-application-visual-copy{padding:12px 12px 13px}
 .fenek-application-visual-copy h4{font-size:.92rem}
 .fenek-application-visual-copy p{font-size:.79rem}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-card{display:flex;flex-direction:column}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-figure{width:100%;aspect-ratio:1}
 .fenek-application-visual-grid.v3-reviewed .fenek-v3-upgraded-figure{aspect-ratio:3/2}
 .fenek-application-visual-grid.v3-reviewed .fenek-v3-reviewed-photo{width:100%}
 .fenek-application-visual-grid.v3-reviewed .fenek-application-visual-copy{padding:12px 15px 15px}
 }
 @media print{.fenek-application-visual{break-inside:auto}
 .fenek-application-visual-card{box-shadow:none}
 .fenek-application-visual-grid.has-drawings{grid-template-columns:repeat(3,minmax(0,1fr))}
 .fenek-application-visual-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 }
</style>
