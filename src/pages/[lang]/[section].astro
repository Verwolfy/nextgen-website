---
import Layout from '../../layouts/Layout.astro';
import ContactChannels from '../../components/ContactChannels.astro';
import {contactCopy} from '../../data/contact-channels';
import RangeOverview from '../../components/RangeOverview.astro';
import ResourcesHub from '../../components/ResourcesHub.astro';
import AboutStory from '../../components/AboutStory.astro';
import AboutVideo from '../../components/AboutVideo.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import {brand,brandLocation,languages,messages,sections,rangeName,type Lang,type Section} from '../../data/site';
import {products} from '../../lib/products';
import ConceptCatalogue from '../../components/ConceptCatalogue.astro';
import {catalogueCopy} from '../../data/catalogue-content';
export function getStaticPaths(){return languages.flatMap(lang=>sections.map(section=>({params:{lang,section}})))}
const lang=Astro.params.lang as Lang;
const section=Astro.params.section as Section;
const t=messages[lang];
const title=t.menu[section];
const heading=section==='catalogue'?catalogueCopy[lang].title:section==='contact'?t.contactTitle:section==='distributeurs'?t.distributorsTitle:title;
const description=section==='catalogue'?catalogueCopy[lang].lead:section==='distributeurs'?t.distributorsInfo:section==='ressources'?t.resourcesInfo:section==='a-propos'?t.aboutInfo:section==='mentions-legales'?t.legalInfo:section==='confidentialite'?t.privacyInfo:section==='contact'?contactCopy[lang].intro:t.intro;
const aboutVideoReady=section==='a-propos' && existsSync(join(process.cwd(),'public/videos/nextgen-about-v1.mp4'));
const aboutVideoLabel:Record<Lang,string>={fr:'Présentation vidéo de NextGen',ar:'فيديو تعريفي عن NextGen',en:'NextGen video introduction'};
---
<Layout lang={lang} title={title} description={description}>
{section==='a-propos' && (
  <section class="about-video-intro" aria-label={aboutVideoLabel[lang]}>
    <div class="container about-video-intro-inner">
      <h1 class="about-video-title">{heading}</h1>
      {aboutVideoReady
        ? <AboutVideo lang={lang} />
        : <img class="about-video-poster-fallback" src="/images/Nexo-Geno.webp" alt={t.mascotsAlt} width="800" height="1390" />
      }
      <p class="about-video-lead">{description}</p>
    </div>
  </section>
)}
{section!=='a-propos' && <div class="page-head"><div class="container"><span class="eyebrow">NextGen Building Solutions</span><h1>{heading}</h1><p>{description}</p></div></div>}
<div class="section"><div class="container">
{section==='gammes'&&<RangeOverview lang={lang} />}
{section==='catalogue'&&<ConceptCatalogue lang={lang} />}
{section==='distributeurs'&&<><div class="notice"><p>{t.distributorsInfo}</p><div class="actions"><a class="btn" href="#contact-direct">{contactCopy[lang].heading}</a></div></div><ContactChannels lang={lang} /></>}
{section==='ressources'&&<ResourcesHub lang={lang} />}
{section==='a-propos'&&<AboutStory lang={lang} />}
{section==='contact'&&<><ContactChannels lang={lang} /></>}
{section==='mentions-legales'&&<div class="notice"><p>{t.legalInfo}</p><p><bdi dir="ltr">NextGen Building Solutions</bdi> · {brandLocation[lang]}</p></div>}
{section==='confidentialite'&&<div class="notice"><p>{t.privacyInfo}</p><p><a href={`mailto:${brand.email}`}>{brand.email}</a></p></div>}
</div></div>
<style>
  .about-video-intro{padding:clamp(20px,3.2vw,42px) 0 clamp(28px,4vw,48px);background:radial-gradient(circle at 80% 0%,#176e70 0,transparent 52%),linear-gradient(120deg,#0b2741,#0a3c47 65%,#0b2741);overflow:hidden}
  .about-video-intro-inner{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(15px,2.3vw,26px)}
  .about-video-title{margin:0;text-align:center;color:#fff;font-size:clamp(1.9rem,4.2vw,3.65rem);line-height:1.25}
  .about-video-lead{margin:0;max-width:860px;color:#e3eff1;text-align:center;font-size:clamp(.98rem,1.45vw,1.16rem);line-height:1.7}
  .about-video-poster-fallback{display:block;width:auto;height:auto;max-width:min(100%,410px);max-height:420px;object-fit:contain;border-radius:17px;background:#fff}
  @media(max-width:580px){
    .about-video-intro{padding:14px 0 25px}
    .about-video-intro-inner{padding-inline:10px;gap:13px}
    .about-video-title{font-size:clamp(1.7rem,7vw,2.3rem)}
    .about-video-lead{font-size:.96rem;line-height:1.65}
  }
</style>
</Layout>
