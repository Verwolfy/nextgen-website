---
import Layout from '../../../layouts/Layout.astro';
import {brand, languages, rangeName, rangeColor, type Lang} from '../../../data/site';
import {catalogueProjects, conceptPackshot, type CatalogueProject} from '../../../lib/catalogue-projets';

export function getStaticPaths() {
  return languages.flatMap(lang => catalogueProjects.map(product => ({
    params: {lang, slug: product.slug},
    props: {product},
  })));
}
const lang = Astro.params.lang as Lang;
const product = Astro.props.product as CatalogueProject;
if (!product || !catalogueProjects.some(p => p.slug === product.slug)) {
  throw Error('Unknown FENEK reference');
}
const copy = {
  fr: {
    title: 'Fiche produit',
    lead: 'Découvrez la référence FENEK, son domaine d’application et ses présentations.',
    overview: 'Présentation',
    profile: 'Identité produit',
    kind: 'Désignation',
    reference: 'Référence',
    range: 'Gamme',
    fields: 'Domaines d’application',
    packaging: 'Formats de présentation',
    packagingNote: 'Formats présentés à titre indicatif ; disponibilité et conditionnements définitifs sur confirmation.',
    formatUnknown: 'Consultez notre équipe pour les formats proposés.',
    technical: 'Informations techniques',
    technicalText: 'Pour obtenir les caractéristiques vérifiées, les conditions de mise en œuvre et les documents de sécurité correspondant à cette référence, contactez l’équipe NextGen.',
    contact: 'Demander une fiche technique',
    email: 'Écrire à notre équipe',
    print: 'Imprimer ou enregistrer en PDF',
    back: 'Retour au catalogue',
    image: 'Visuel de présentation de',
    footer: 'Présentation de gamme non contractuelle. Vérifier les instructions techniques propres au produit avant toute utilisation.',
  },
  ar: {
    title: 'بطاقة المنتج',
    lead: 'تعرّف على مرجع FENEK ومجالات استخدامه وعبواته المقترحة.',
    overview: 'نظرة عامة',
    profile: 'هوية المنتج',
    kind: 'الوصف',
    reference: 'المرجع',
    range: 'المجموعة',
    fields: 'مجالات الاستخدام',
    packaging: 'أحجام العبوات المقترحة',
    packagingNote: 'الأحجام المعروضة إرشادية، ويجب تأكيد التوفر والتعبئة النهائية.',
    formatUnknown: 'يرجى التواصل مع فريقنا لمعرفة العبوات المقترحة.',
    technical: 'المعلومات الفنية',
    technicalText: 'للحصول على الخصائص الفنية التي تم التحقق منها وشروط التطبيق ووثائق السلامة الخاصة بهذا المرجع، تواصل مع فريق NextGen.',
    contact: 'طلب النشرة الفنية',
    email: 'مراسلة الفريق',
    print: 'طباعة البطاقة أو حفظها PDF',
    back: 'العودة إلى الكتالوج',
    image: 'صورة توضيحية للمنتج',
    footer: 'عرض تعريفي غير تعاقدي. يجب التحقق من تعليمات المنتج الفنية قبل أي استخدام.',
  },
  en: {
    title: 'Product sheet',
    lead: 'Explore the FENEK reference, its intended applications and available catalogue presentations.',
    overview: 'Overview',
    profile: 'Product identity',
    kind: 'Product type',
    reference: 'Reference',
    range: 'Range',
    fields: 'Application areas',
    packaging: 'Proposed packaging formats',
    packagingNote: 'Catalogue formats are indicative; final packaging and availability require confirmation.',
    formatUnknown: 'Contact our team for proposed packaging options.',
    technical: 'Technical information',
    technicalText: 'For verified characteristics, application conditions and safety documentation specific to this reference, contact the NextGen team.',
    contact: 'Request a technical datasheet',
    email: 'Email our team',
    print: 'Print or save as PDF',
    back: 'Back to catalogue',
    image: 'Presentation image for',
    footer: 'Non-contractual range presentation. Check the product-specific technical instructions before use.',
  },
}[lang];
const detail = product.contenu[lang];
const subject = encodeURIComponent('FENEK — technical information: ' + product.nom);
const directEmail = 'mailto:' + brand.email + '?subject=' + subject;
---
<Layout lang={lang} title={product.nom + ' — ' + copy.title} description={detail.description}>
  <div class="page-head fenek-sheet-head" style={'--range-color:' + rangeColor[product.gamme]}>
    <div class="container">
      <a class="concept-back" href={`/${lang}/catalogue/`}>{copy.back}</a>
      <span class="eyebrow">FENEK · {copy.title}</span>
      <h1><bdi dir="ltr">{product.nom}</bdi></h1>
      <p>{detail.accroche}</p>
    </div>
  </div>
  <article class="section fenek-sheet">
    <div class="container">
      <div class="market-sheet-paper fenek-sheet-paper">
        <div class="fenek-sheet-intro">
          <div class="fenek-sheet-intro-copy">
            <span class="fenek-sheet-overline">{copy.overview}</span>
            <h2>{copy.title}</h2>
            <p>{detail.description}</p>
            <div class="fenek-reference-label"><bdi dir="ltr">{product.code}</bdi></div>
          </div>
          <figure class="fenek-sheet-visual">
            <img
              src={conceptPackshot(product, 'full')}
              width="800" height="800"
              alt={`${copy.image} ${product.nom}`}
              loading="eager" decoding="async"
            />
            <figcaption>{copy.footer}</figcaption>
          </figure>
        </div>
        <div class="fenek-sheet-content">
          <section aria-labelledby="fenek-identity">
            <h2 id="fenek-identity">{copy.profile}</h2>
            <dl class="fenek-spec-grid">
              <div><dt>{copy.reference}</dt><dd><bdi dir="ltr">{product.nom}</bdi></dd></div>
              <div><dt>{copy.range}</dt><dd><bdi dir="ltr">{rangeName[product.gamme]}</bdi></dd></div>
              <div class="fenek-spec-wide"><dt>{copy.kind}</dt><dd>{detail.accroche}</dd></div>
            </dl>
          </section>
          <section aria-labelledby="fenek-use">
            <h2 id="fenek-use">{copy.fields}</h2>
            <ul class="fenek-sheet-tags">
              {detail.usages.map(use => <li>{use}</li>)}
            </ul>
          </section>
          <section aria-labelledby="fenek-pack">
            <h2 id="fenek-pack">{copy.packaging}</h2>
            {product.conditionnements.length > 0
              ? <div class="fenek-sheet-tags fenek-pack-list">
                  {product.conditionnements.map(c => <span>{c.format}</span>)}
                </div>
              : <p>{copy.formatUnknown}</p>}
            <p class="fenek-sheet-small">{copy.packagingNote}</p>
          </section>
          <section class="fenek-tech-contact" aria-labelledby="fenek-tech">
            <h2 id="fenek-tech">{copy.technical}</h2>
            <p>{copy.technicalText}</p>
            <div class="market-sheet-footer">
              <a class="btn" href={`/${lang}/contact/`}>{copy.contact}</a>
              <a class="btn btn-muted" href={directEmail}>{copy.email}</a>
              <button class="btn btn-muted market-print" type="button" data-print-market-sheet>{copy.print}</button>
            </div>
          </section>
        </div>
      </div>
    </div>
  </article>
</Layout>
<script>
  document.querySelector<HTMLButtonElement>('[data-print-market-sheet]')?.addEventListener('click', () => window.print());
</script>
