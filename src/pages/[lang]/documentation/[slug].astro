---
import Layout from '../../../layouts/Layout.astro';
import {languages, brand, rangeName, type Lang} from '../../../data/site';
import {catalogueProjects, type CatalogueProject} from '../../../lib/catalogue-projets';
import benchmarks from '../../../data/market-comparisons.json';
import archiveLocales from '../../../data/market-locales/archive.json';
import manufacturerLocales from '../../../data/market-locales/manufacturers.json';
import additionLocales from '../../../data/market-locales/additions.json';

export function getStaticPaths() {
  return languages.flatMap(lang => catalogueProjects.map(product => ({
    params: {lang, slug: product.slug},
    props: {product},
  })));
}
const lang = Astro.params.lang as Lang;
const product = Astro.props.product as CatalogueProject;
if (!product || !catalogueProjects.some(p => p.code === product.code)) throw Error('Unknown product');
const item = benchmarks.products.find(p => p.sku === product.code);
if (!item) throw Error('Missing documentary coverage ' + product.code);
const localizedReferenceText: Record<string, {en:{observed:string;limit:string};ar:{observed:string;limit:string}}> = {
  ...archiveLocales, ...manufacturerLocales, ...additionLocales,
};
const sources = benchmarks.sources
  .filter(s => item.source_ids.includes(s.id))
  .map(s => {
    const translations = localizedReferenceText[s.id];
    if (!translations) throw Error('No verified reference translation for ' + s.id);
    const content = lang === 'fr'
      ? {observed:s.observed,limit:s.limit}
      : (lang === 'ar' ? translations.ar : translations.en);
    return {...s, observed:content.observed,limit:content.limit};
  });
const t = {
  fr: {
    heading:'Fiche d’information produit',
    lead:'Description FENEK et repères documentaires issus de fabricants comparables.',
    warning:'Les valeurs ci-dessous concernent uniquement les produits tiers cités. Ce ne sont ni des performances mesurées sur FENEK, ni des dosages à employer sur chantier, ni des certifications.',
    synopsis:'Présentation du produit', uses:'Domaines présentés', formats:'Conditionnements envisagés',
    formatNote:'Formats éditoriaux à confirmer auprès de NextGen, non disponibles comme formats approuvés.',
    market:'Références techniques externes', sourceLabel:'Produit comparable', readings:'Données annoncées pour ce produit tiers',
    source:'Consulter la source officielle', archive:'Relevé des PDF transmis (source tierce non redistribuée)',
    noSource:'Aucun produit suffisamment proche n’est documenté pour cette référence ; aucune moyenne n’a été calculée.',
    noAverage:'Une moyenne de chiffres non homogènes (formulation, support, climat, méthode d’essai) serait trompeuse. Les observations restent rattachées à leur produit et à leur source.',
    safety:'Sécurité et validation', safetyText:'Aucune FDS NextGen ni formulation validée n’est disponible dans ce dossier. Demandez la documentation propre au produit avant tout emploi.',
    contact:'Demander les informations techniques', print:'Imprimer / enregistrer en PDF', back:'Retour au catalogue',
    
  },
  ar: {
    heading:'بطاقة معلومات المنتج',
    lead:'وصف مجموعة FENEK ومراجع تقنية من منتجات شركات أخرى قابلة للمقارنة.',
    warning:'القيم المذكورة أدناه تخص المنتجات الأخرى المسماة فقط، ولا تمثل نتائج اختبارات FENEK أو جرعات تطبيق معتمدة أو شهادات مطابقة.',
    synopsis:'وصف المنتج', uses:'مجالات الاستخدام المقترحة', formats:'العبوات المقترحة',
    formatNote:'أحجام من الكتالوج التوضيحي تتطلب تأكيد NextGen؛ لم تعتمد كعبوات تجارية.',
    market:'المراجع التقنية الخارجية', sourceLabel:'المنتج المقارن', readings:'القيم المنشورة للمنتج الآخر',
    source:'عرض مصدر الشركة المصنعة', archive:'بيانات مختصرة من ملفات PDF المقدمة (مصدر خارجي)',
    noSource:'لا تتوفر وثيقة مقاربة بما يكفي لهذا المرجع؛ لم تُحسب أي قيمة متوسطة.',
    noAverage:'إن متوسط نتائج منتجات مختلفة من حيث التركيب والسطح والمناخ وطريقة الاختبار قد يكون مضللاً؛ لذلك تبقى كل قيمة مرتبطة بمصدرها.',
    safety:'السلامة والاعتماد', safetyText:'لا تتوفر في هذا الملف صحيفة بيانات سلامة أو تركيبة معتمدة تخص FENEK. اطلب المعلومات الخاصة بالمنتج قبل الاستخدام.',
    contact:'طلب المعلومات الفنية', print:'طباعة / حفظ بصيغة PDF', back:'العودة إلى الكتالوج',
    
  },
  en: {
    heading:'Product information sheet',
    lead:'FENEK description with supporting references to comparable manufacturers’ products.',
    warning:'The figures below apply exclusively to the named third-party products. They are not FENEK test results, approved jobsite mixing rates or certifications.',
    synopsis:'Product overview', uses:'Proposed application areas', formats:'Provisional packaging formats',
    formatNote:'Editorial catalogue formats; not confirmed by NextGen as approved commercial packaging.',
    market:'External technical references', sourceLabel:'Comparable product', readings:'Figures stated for this third-party product',
    source:'Open manufacturer source', archive:'Summary from supplied third-party PDFs (not redistributed)',
    noSource:'No sufficiently comparable document has been established for this reference; no average has been computed.',
    noAverage:'Averaging numbers from different formulations, substrates, climates and test methods would be misleading. Each observation remains linked to its specific product and source.',
    safety:'Safety and approval', safetyText:'No validated FENEK formulation or FENEK Safety Data Sheet is available in this record. Request product-specific documents before use.',
    contact:'Request technical information', print:'Print / save as PDF', back:'Back to catalogue',
    
  },
}[lang];
const noteTitle = product.nom + ' — ' + t.heading;
const contactLink = 'mailto:' + brand.email + '?subject=' + encodeURIComponent('Technical information ' + product.nom);
---
<Layout lang={lang} title={noteTitle} description={t.lead}>
  <div class="page-head market-doc-head">
    <div class="container">
      <a class="concept-back" href={`/${lang}/catalogue/`}>{t.back}</a>
      <span class="eyebrow">FENEK · {rangeName[product.gamme]}</span>
      <h1><bdi dir="ltr">{product.nom}</bdi></h1>
      <p>{t.heading}</p>
    </div>
  </div>
  <article class="section market-sheet"><div class="container">
    <div class="market-sheet-paper">
      <p class="market-sheet-warning" role="note">{t.warning}</p>
      <header class="market-sheet-title"><h2>{t.synopsis}</h2><p>{product.contenu[lang].description}</p></header>
      <section aria-labelledby="market-uses"><h2 id="market-uses">{t.uses}</h2>
        <ul>{product.contenu[lang].usages.map(use=><li>{use}</li>)}</ul>
      </section>
      <section aria-labelledby="market-formats"><h2 id="market-formats">{t.formats}</h2>
        <p>{product.conditionnements.length ? product.conditionnements.map(c => c.format).join(' · ') : t.formatNote}</p>
        {product.conditionnements.length > 0 && <p class="market-sheet-small">{t.formatNote}</p>}
      </section>
      <section aria-labelledby="market-reference"><h2 id="market-reference">{t.market}</h2>
        {sources.length === 0 ? <p>{t.noSource}</p> :
          <>
            <p class="market-sheet-small">{t.noAverage}</p>
            <div class="market-reference-list">
              {sources.map(s=><div class="market-reference">
                <h3><bdi dir="ltr">{s.name}</bdi></h3>
                <p><strong>{t.readings} :</strong> <span lang={lang} dir="auto">{s.observed}</span></p>
                <p class="market-sheet-small" lang={lang} dir="auto">{s.limit}</p>
                {s.url ? <a href={s.url} target="_blank" rel="noopener noreferrer">{t.source} ↗</a> :
                  <span class="market-sheet-small">{t.archive} · {s.id}</span>}
              </div>)}
            </div>
            
          </>}
      </section>
      <section aria-labelledby="market-safety"><h2 id="market-safety">{t.safety}</h2><p>{t.safetyText}</p></section>
      <footer class="market-sheet-footer">
        <a class="btn" href={contactLink}>{t.contact}</a>
        <button class="btn btn-muted market-print" type="button" data-print-market-sheet>{t.print}</button>
      </footer>
    </div>
  </div></article>
</Layout>
<script>
  document.querySelector<HTMLButtonElement>('[data-print-market-sheet]')?.addEventListener('click',()=>window.print());
</script>
