---
import Layout from '../../../layouts/Layout.astro';
import {languages,rangeName,rangeColor,type Lang} from '../../../data/site';
import {catalogueProjects,conceptPackshot,hasProductPackshot,type CatalogueProject} from '../../../lib/catalogue-projets';
import {catalogueCopy} from '../../../data/catalogue-content';
export function getStaticPaths(){
 return languages.flatMap(lang=>catalogueProjects.map(product=>({params:{lang,slug:product.slug},props:{product}})));
}
const lang=Astro.params.lang as Lang;
const product=Astro.props.product as CatalogueProject;
if(!product || !catalogueProjects.some(p=>p.slug===product.slug)) throw Error('Unknown catalogue concept');
const d=product.contenu[lang];
const t=catalogueCopy[lang];
---
<Layout lang={lang} title={product.nom} description={d.description}>
  <div class="page-head concept-detail-head" style={'--range-color:'+rangeColor[product.gamme]}>
    <div class="container">
      <a class="concept-back" href={'/'+lang+'/catalogue/'}>{t.back}</a>
      <span class="eyebrow"><bdi dir="ltr">{rangeName[product.gamme]}</bdi> · {t.concept}</span>
      <h1><bdi dir="ltr">{product.nom}</bdi></h1>
      <p>{d.accroche}</p>
      <span class="concept-detail-status">{t.status}</span>
    </div>
  </div>
  <section class="section"><div class="container">
    <div class="concept-detail-layout">
      <div class="concept-detail-main">
        <p class="editorial-caution" role="note">{t.review}</p>
        <h2>{t.application}</h2><p>{d.description}</p>
        {d.usages.length>0&&<ul class="concept-usages">{d.usages.map(x=><li>{x}</li>)}</ul>}
        <h2>{t.format}</h2>
        <div class="concept-formats detail-formats">{product.conditionnements.length?product.conditionnements.map(x=><span>{x.format}</span>):<span>{t.unknownFormat}</span>}</div>
        <p class="concept-detail-note">{t.revision}</p>
        <p class="concept-detail-note">{t.methodDisclaimer}</p>
      </div>
      <aside class="concept-detail-aside" aria-label={t.format}>
        <div class="concept-detail-image concept-packshot-container" style={'--range-color:'+rangeColor[product.gamme]}>
          <img src={conceptPackshot(product,"full")} width="800" height="800" alt="" loading="lazy"/>
        </div>
        <p class="concept-detail-note">{product.gamme==='paint'?t.paintConceptNote:hasProductPackshot(product)?t.packshotNote:t.pictureNote}</p>
        <a class="btn" href={'/'+lang+'/contact/'}>{t.quote}</a>
      </aside>
    </div>
  </div></section>
</Layout>
