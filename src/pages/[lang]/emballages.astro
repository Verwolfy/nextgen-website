---
import Layout from '../../layouts/Layout.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import {languages, type Lang} from '../../data/site';
import manifest from '../../../supports/3d/manifest.json';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const copy={
 fr:{eyebrow:'Étude de conception',title:'Maquettes 3D des conditionnements',lead:'Présentations indicatives de cinq formats d’emballages NextGen.',notice:'Explorez les formats d’emballage en trois dimensions. Pour les spécifications techniques, contactez NextGen.',names:['Sac 25 kg','Seau 20 kg','Bidon 20 L','Fût 200 L','Cubi IBC 1 000 L'],back:'Retour aux gammes',open:'Ouvrir la maquette 3D'},
 ar:{eyebrow:'تصاميم أولية',title:'تصاميم العبوات ثلاثية الأبعاد',lead:'خمسة نماذج توضيحية لأشكال عبوات مقترحة، وليست منتجات جاهزة للبيع.',notice:'استكشف نماذج العبوات ثلاثية الأبعاد. للمواصفات الفنية يرجى التواصل مع NextGen.',names:['كيس بوزن 25 كغ','دلو بوزن 20 كغ','عبوة بسعة 20 لترًا','برميل بسعة 200 لتر','خزان IBC بسعة 1,000 لتر'],back:'العودة إلى الفئات التقنية',open:'فتح النموذج ثلاثي الأبعاد'},
 en:{eyebrow:'Design study',title:'3D packaging design previews',lead:'Illustrative concept renders of five NextGen packaging formats.',notice:'Explore the packaging formats in 3D. Contact NextGen for technical specifications.',names:['25 kg bag','20 kg pail','20 L jerrycan','200 L drum','1,000 L IBC tote'],back:'Back to product ranges',open:'Open the interactive 3D model'},
}[lang];
const order=['sac-25kg','seau-20kg','bidon-20l','fut-200l','ibc-1000l'];
const display=order.map((slug,index)=>({...manifest.find(x=>x.code===slug),slug,name:copy.names[index]}));
---
<Layout lang={lang} title={copy.title} description={copy.lead}>
<div class="page-head"><div class="container"><span class="eyebrow">NextGen · {copy.eyebrow}</span><h1>{copy.title}</h1><p>{copy.lead}</p></div></div>
<section class="section"><div class="container">
 <p class="notice" role="note"><strong>{copy.notice}</strong></p>
 <div class="showcase-grid">{display.map(item=><article class="showcase-card" id={item.slug}>
  <h2 dir="auto">{item.name}</h2>
  <ModelViewer language={lang} src={`/models-demo/${item.slug}.glb`} poster={`/images/3d-demo/${item.slug}-30.webp`} label={`${item.name} — ${copy.notice}`} />
  <p><a class="btn btn-outline" href={`/${lang}/emballages/${item.slug}/`}>{copy.open}</a></p>
 </article>)}</div>
 <p><a class="btn" href={`/${lang}/gammes/`}>{copy.back}</a></p>
</div></section>
</Layout>
