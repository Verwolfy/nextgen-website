---
import Layout from '../../layouts/Layout.astro';
import { languages, type Lang } from '../../data/site';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const copy = {
  fr: {
    title: 'Maquettes visuelles NextGen',
    intro: '46 rendus visuels issus des études graphiques NextGen. Ce sont des concepts, pas des fiches produits.',
    notice: 'Galerie de créations visuelles NextGen. Les images présentent des designs graphiques, sans constituer des fiches techniques.',
    number: 'Maquette',
    type: 'Design de la gamme FENEK',
    open: 'Voir l’image en grand',
    back: 'Explorer le catalogue',
    resource: 'Retour aux ressources',
  },
  ar: {
    title: 'نماذج نكست جن المصوّرة',
    intro: '46 صورة من التصاميم الأولية لشركة NextGen، وليست نشرات منتجات فنية.',
    notice: 'معرض التصاميم المرئية لشركة NextGen. الصور تصاميم فنية وليست نشرات تقنية.',
    number: 'نموذج',
    type: 'تصميم FENEK',
    open: 'عرض الصورة بحجم أكبر',
    back: 'استكشف الكتالوج',
    resource: 'العودة إلى الموارد',
  },
  en: {
    title: 'NextGen visual concepts',
    intro: '46 visual design concepts from the NextGen project, not technical product datasheets.',
    notice: 'NextGen visual design gallery. Images show graphic design concepts and are not technical datasheets.',
    number: 'Concept',
    type: 'FENEK range design',
    open: 'Open full image',
    back: 'Explore the catalogue',
    resource: 'Back to resources',
  },
}[lang];
const items = Array.from({length: 46}, (_, i) => {
  const number = String(i + 1).padStart(2, '0');
  return { number, src: `/images/maquettes/maquette-${number}.webp` };
});
---
<Layout lang={lang} title={copy.title} description={copy.intro}>
  <div class="page-head"><div class="container">
    <span class="eyebrow">NextGen · Design</span>
    <h1>{copy.title}</h1>
    <p>{copy.intro}</p>
  </div></div>
  <section class="section"><div class="container">
    <p class="notice" role="note"><strong>{copy.notice}</strong></p>
    <div class="visual-concept-grid">
      {items.map(item => (
        <figure class="visual-concept-card">
          <a href={item.src} target="_blank" rel="noopener noreferrer" aria-label={`${copy.open} — ${copy.number} ${item.number}`}>
            <img src={item.src} alt={`${copy.number} ${item.number} — ${copy.type}`} width="880" height="880" loading="lazy" decoding="async" />
          </a>
          <figcaption>
            <strong>{copy.number} {item.number}</strong>
            <span>{copy.type}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="actions">
      <a class="btn" href={`/${lang}/catalogue/`}>{copy.back}</a>
      <a class="btn btn-outline" href={`/${lang}/ressources/`}>{copy.resource}</a>
    </div>
  </div></section>
</Layout>
